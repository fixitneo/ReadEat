+import { fetch as tauriFetch } from '@tauri-apps/plugin-http';
+import { withOriginSuppressed } from '@/app/opds/utils/opdsReq';
+import type { GrimmorySettings } from '@/types/settings';
+import { normalizeCustomHeaders } from '@/utils/customHeaders';
+import { stubTranslation as _ } from '@/utils/misc';
+import { isLanAddress } from '@/utils/network';
+import { allowsSelfSignedCert, tlsFetch } from '@/utils/tls';
+import { getAPIBaseUrl, isTauriAppPlatform } from '../environment';
+import type {
+  GrimmoryAnnotation,
+  GrimmoryAnnotationCreate,
+  GrimmoryAnnotationUpdate,
+  GrimmoryBook,
+  GrimmoryBookmark,
+  GrimmoryBookmarkCreate,
+  GrimmoryBookmarkUpdate,
+  GrimmoryBookType,
+  GrimmoryProgressUpdate,
+  GrimmoryProxyPayload,
+  GrimmoryReadStatus,
+  GrimmoryReadingSession,
+  GrimmorySessionPage,
+} from './types';
+
+export type GrimmoryConnection = Pick<
+  GrimmorySettings,
+  'serverUrl' | 'username' | 'password' | 'customHeaders' | 'allowSelfSignedCert'
+>;
+
+export class GrimmoryRequestError extends Error {
+  status: number;
+
+  constructor(status: number, message: string) {
+    super(message);
+    this.name = 'GrimmoryRequestError';
+    this.status = status;
+  }
+}
+
+type Method = 'GET' | 'POST' | 'PUT' | 'DELETE';
+
+interface RequestInit {
+  method?: Method;
+  headers?: Record<string, string>;
+  body?: unknown;
+}
+
+// Access tokens last two hours. Keep them for the life of the app, shared by
+// every client for the same account, so each sync pass doesn't sign in again.
+const tokens = new Map<string, string>();
+const logins = new Map<string, Promise<string>>();
+
+export const normalizeGrimmoryServerUrl = (url: string): string => url.trim().replace(/\/+$/, '');
+
+/** Identifies the account a stored match or mapping belongs to. */
+export const grimmoryAccountKey = (config: Pick<GrimmorySettings, 'serverUrl' | 'username'>) =>
+  `${normalizeGrimmoryServerUrl(config.serverUrl)}|${config.username}`;
+
+const errorMessage = async (response: Response): Promise<string> => {
+  const data: unknown = await response.json().catch(() => null);
+  if (data && typeof data === 'object' && 'message' in data) {
+    const message = (data as { message: unknown }).message;
+    if (typeof message === 'string' && message) return message;
+  }
+  return `Grimmory request failed with status ${response.status}`;
+};
+
+/**
+ * Client for a Grimmory server's REST API. Signs in with the account's
+ * username and password and sends the bearer token; a 401 signs in again once.
+ */
+export class GrimmoryClient {
+  private config: GrimmoryConnection;
+  private serverUrl: string;
+  private accountKey: string;
+
+  constructor(config: GrimmoryConnection) {
+    this.config = config;
+    this.serverUrl = normalizeGrimmoryServerUrl(config.serverUrl);
+    this.accountKey = grimmoryAccountKey(config);
+  }
+
+  private async send(path: string, init: RequestInit, token?: string): Promise<Response> {
+    const method = init.method ?? 'GET';
+    const headers: Record<string, string> = {
+      ...normalizeCustomHeaders(this.config.customHeaders),
+      Accept: 'application/json',
+      ...(token ? { Authorization: `Bearer ${token}` } : {}),
+      ...init.headers,
+    };
+    const body = init.body === undefined ? undefined : JSON.stringify(init.body);
+    if (body !== undefined) headers['Content-Type'] = 'application/json';
+
+    // The web build can't reach a public server directly when its CORS policy
+    // leaves Readest out, so it goes through the proxy; a LAN server is out of
+    // the proxy's reach and is fetched directly.
+    if (isTauriAppPlatform() || isLanAddress(this.serverUrl)) {
+      return await tlsFetch(
+        isTauriAppPlatform() ? tauriFetch : window.fetch,
+        `${this.serverUrl}${path}`,
+        { method, headers: withOriginSuppressed(headers), body },
+        allowsSelfSignedCert(this.config),
+      );
+    }
+    const payload: GrimmoryProxyPayload = {
+      serverUrl: this.serverUrl,
+      path,
+      method,
+      headers,
+      body,
+    };
+    return await fetch(`${getAPIBaseUrl()}/grimmory`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify(payload),
+    });
+  }
+
+  private async login(): Promise<string> {
+    const inFlight = logins.get(this.accountKey);
+    if (inFlight) return inFlight;
+    const login = (async () => {
+      const response = await this.send('/api/v1/auth/login', {
+        method: 'POST',
+        body: { username: this.config.username, password: this.config.password },
+      });
+      if (!response.ok) {
+        throw new GrimmoryRequestError(response.status, await errorMessage(response));
+      }
+      // A wrong Server URL can land on a page that answers 200 with HTML.
+      const data: unknown = await response.json().catch(() => null);
+      const token =
+        data && typeof data === 'object' && 'accessToken' in data
+          ? (data as { accessToken: unknown }).accessToken
+          : null;
+      if (typeof token !== 'string' || !token) {
+        throw new GrimmoryRequestError(0, _('Not a Grimmory server. Check the Server URL.'));
+      }
+      tokens.set(this.accountKey, token);
+      return token;
+    })().finally(() => logins.delete(this.accountKey));
+    logins.set(this.accountKey, login);
+    return login;
+  }
+
+  private async authorized(path: string, init: RequestInit = {}): Promise<Response> {
+    let token = tokens.get(this.accountKey) ?? (await this.login());
+    let response = await this.send(path, init, token);
+    if (response.status === 401) {
+      tokens.delete(this.accountKey);
+      token = await this.login();
+      response = await this.send(path, init, token);
+    }
+    return response;
+  }
+
+  private async json<T>(path: string, init: RequestInit = {}): Promise<T> {
+    const response = await this.authorized(path, init);
+    if (!response.ok) {
+      throw new GrimmoryRequestError(response.status, await errorMessage(response));
+    }
+    return (await response.json()) as T;
+  }
+
+  private async call(path: string, init: RequestInit, allowNotFound = false): Promise<void> {
+    const response = await this.authorized(path, init);
+    if (response.ok || (allowNotFound && response.status === 404)) return;
+    throw new GrimmoryRequestError(response.status, await errorMessage(response));
+  }
+
+  private connectionFailure(error: unknown) {
+    if (error instanceof GrimmoryRequestError && error.status === 401) {
+      return { success: false, message: _('Invalid credentials.') };
+    }
+    return { success: false, message: (error as Error).message || _('Connection error.') };
+  }
+
+  async connect(): Promise<{ success: boolean; message?: string }> {
+    try {
+      tokens.delete(this.accountKey);
+      await this.login();
+      await this.json<{ current?: string }>('/api/v1/version');
+      return { success: true };
+    } catch (error) {
+      return this.connectionFailure(error);
+    }
+  }
+
+  /** Reuses the session, unlike {@link connect}: a sync may be using that token. */
+  async checkConnection(): Promise<{ success: boolean; message?: string }> {
+    try {
+      await this.json<{ current?: string }>('/api/v1/version');
+      return { success: true };
+    } catch (error) {
+      return this.connectionFailure(error);
+    }
+  }
+
+  listBooks(): Promise<GrimmoryBook[]> {
+    return this.json<GrimmoryBook[]>('/api/v1/books');
+  }
+
+  getBook(bookId: number): Promise<GrimmoryBook> {
+    return this.json<GrimmoryBook>(`/api/v1/books/${bookId}`);
+  }
+
+  /** Bytes [start, end) of a book file, via an HTTP Range request. */
+  async readContent(
+    bookId: number,
+    bookType: GrimmoryBookType | null | undefined,
+    start: number,
+    end: number,
+  ): Promise<Uint8Array> {
+    const query = bookType ? `?bookType=${encodeURIComponent(bookType)}` : '';
+    const response = await this.authorized(`/api/v1/books/${bookId}/content${query}`, {
+      headers: { Accept: '*/*', Range: `bytes=${start}-${end - 1}` },
+    });
+    if (!response.ok) {
+      throw new GrimmoryRequestError(
+        response.status,
+        `Content request failed (${response.status})`,
+      );
+    }
+    const bytes = new Uint8Array(await response.arrayBuffer());
+    // A server that ignores Range sends the whole file from byte 0.
+    return response.status === 206 ? bytes : bytes.slice(start, end);
+  }
+
+  getAnnotations(bookId: number): Promise<GrimmoryAnnotation[]> {
+    return this.json<GrimmoryAnnotation[]>(`/api/v1/annotations/book/${bookId}`);
+  }
+
+  createAnnotation(body: GrimmoryAnnotationCreate): Promise<GrimmoryAnnotation> {
+    return this.json<GrimmoryAnnotation>('/api/v1/annotations', { method: 'POST', body });
+  }
+
+  updateAnnotation(id: number, body: GrimmoryAnnotationUpdate): Promise<GrimmoryAnnotation> {
+    return this.json<GrimmoryAnnotation>(`/api/v1/annotations/${id}`, { method: 'PUT', body });
+  }
+
+  deleteAnnotation(id: number): Promise<void> {
+    return this.call(`/api/v1/annotations/${id}`, { method: 'DELETE' }, true);
+  }
+
+  getBookmarks(bookId: number): Promise<GrimmoryBookmark[]> {
+    return this.json<GrimmoryBookmark[]>(`/api/v1/bookmarks/book/${bookId}`);
+  }
+
+  createBookmark(body: GrimmoryBookmarkCreate): Promise<GrimmoryBookmark> {
+    return this.json<GrimmoryBookmark>('/api/v1/bookmarks', { method: 'POST', body });
+  }
+
+  updateBookmark(id: number, body: GrimmoryBookmarkUpdate): Promise<GrimmoryBookmark> {
+    return this.json<GrimmoryBookmark>(`/api/v1/bookmarks/${id}`, { method: 'PUT', body });
+  }
+
+  deleteBookmark(id: number): Promise<void> {
+    return this.call(`/api/v1/bookmarks/${id}`, { method: 'DELETE' }, true);
+  }
+
+  updateProgress(body: GrimmoryProgressUpdate): Promise<void> {
+    return this.call('/api/v1/books/progress', { method: 'POST', body });
+  }
+
+  updateReadStatus(bookId: number, status: GrimmoryReadStatus): Promise<void> {
+    return this.call('/api/v1/books/status', {
+      method: 'POST',
+      body: { bookIds: [bookId], status },
+    });
+  }
+
+  getReadingSessions(bookId: number, page: number): Promise<GrimmorySessionPage> {
+    return this.json<GrimmorySessionPage>(
+      `/api/v1/reading-sessions/book/${bookId}?page=${page}&size=100`,
+    );
+  }
+
+  recordReadingSession(body: GrimmoryReadingSession): Promise<void> {
+    return this.call('/api/v1/reading-sessions', { method: 'POST', body });
+  }
+}
diff --git a/apps/readest-app/src/services/grimmory/GrimmorySyncStore.ts b/apps/readest-app/src/services/grimmory/GrimmorySyncStore.ts
new file mode 100644
--- /dev/null
+++ b/apps/readest-app/src/services/grimmory/GrimmorySyncStore.ts
@@ -0,0 +1,185 @@
+import type { AppService } from '@/types/system';
+import type { GrimmoryNoteKind, GrimmoryNoteLink } from './notesSync';
+import type { GrimmoryBookType } from './types';
+
+/** The Grimmory book and file a local book was verified to be. */
+export interface GrimmoryBookMatch {
+  bookId: number;
+  bookFileId: number;
+  bookType: GrimmoryBookType | null;
+  /** Whether the file is the book's primary file (not an alternative format). */
+  isPrimary: boolean;
+  /** readingStatusUpdatedAt of the status last sent; 0 when none was. */
+  statusPushedAt: number;
+}
+
+type BookRow = {
+  book_hash: string;
+  book_id: number;
+  book_file_id: number;
+  book_type: string | null;
+  is_primary: number;
+  status_pushed_at: number;
+};
+
+type LinkRow = {
+  note_id: string;
+  kind: string;
+  server_id: number;
+  local_updated_at: number;
+};
+
+const DB_SCHEMA = 'grimmory-sync';
+const DB_PATH = 'grimmory-sync.db';
+
+type OpenDb = Awaited<ReturnType<AppService['openDatabase']>>;
+
+const toMatch = (row: BookRow): GrimmoryBookMatch => ({
+  bookId: Number(row.book_id),
+  bookFileId: Number(row.book_file_id),
+  bookType: row.book_type,
+  isPrimary: !!Number(row.is_primary),
+  statusPushedAt: Number(row.status_pushed_at),
+});
+
+/**
+ * Local Grimmory sync state, per account (server + user): which Grimmory book
+ * each local book is, and which server item each synced note is linked to.
+ */
+export class GrimmorySyncStore {
+  constructor(private appService: AppService) {}
+
+  // The native plugin keeps one connection per path and close() drops it for
+  // every caller, so calls take turns: one could otherwise close the database
+  // under another, or open a transaction inside another's.
+  private static queue: Promise<unknown> = Promise.resolve();
+
+  private withDb<T>(fn: (db: OpenDb) => Promise<T>): Promise<T> {
+    const run = async () => {
+      const db = await this.appService.openDatabase(DB_SCHEMA, DB_PATH, 'Data');
+      try {
+        return await fn(db);
+      } finally {
+        await db.close();
+      }
+    };
+    const result = GrimmorySyncStore.queue.then(run, run);
+    GrimmorySyncStore.queue = result.catch(() => undefined);
+    return result;
+  }
+
+  private static async inTransaction(db: OpenDb, fn: () => Promise<void>): Promise<void> {
+    await db.execute('BEGIN');
+    try {
+      await fn();
+      await db.execute('COMMIT');
+    } catch (error) {
+      await db.execute('ROLLBACK');
+      throw error;
+    }
+  }
+
+  getBook(account: string, bookHash: string): Promise<GrimmoryBookMatch | null> {
+    return this.withDb(async (db) => {
+      const rows = await db.select<BookRow>(
+        `SELECT * FROM grimmory_books WHERE account = ? AND book_hash = ?`,
+        [account, bookHash],
+      );
+      return rows[0] ? toMatch(rows[0]) : null;
+    });
+  }
+
+  getBooks(account: string): Promise<Map<string, GrimmoryBookMatch>> {
+    return this.withDb(async (db) => {
+      const rows = await db.select<BookRow>(`SELECT * FROM grimmory_books WHERE account = ?`, [
+        account,
+      ]);
+      return new Map(rows.map((row) => [row.book_hash, toMatch(row)]));
+    });
+  }
+
+  setBook(account: string, bookHash: string, match: GrimmoryBookMatch): Promise<void> {
+    return this.withDb(async (db) => {
+      await db.execute(
+        `INSERT INTO grimmory_books
+           (account, book_hash, book_id, book_file_id, book_type, is_primary, status_pushed_at)
+         VALUES (?, ?, ?, ?, ?, ?, ?)
+         ON CONFLICT(account, book_hash) DO UPDATE SET
+           book_id = excluded.book_id,
+           book_file_id = excluded.book_file_id,
+           book_type = excluded.book_type,
+           is_primary = excluded.is_primary,
+           status_pushed_at = excluded.status_pushed_at`,
+        [
+          account,
+          bookHash,
+          match.bookId,
+          match.bookFileId,
+          match.bookType,
+          match.isPrimary ? 1 : 0,
+          match.statusPushedAt,
+        ],
+      );
+    });
+  }
+
+  /** Forget a match and its links, e.g. when the Grimmory book was deleted. */
+  deleteBook(account: string, bookHash: string): Promise<void> {
+    return this.withDb((db) =>
+      GrimmorySyncStore.inTransaction(db, async () => {
+        await db.execute(`DELETE FROM grimmory_books WHERE account = ? AND book_hash = ?`, [
+          account,
+          bookHash,
+        ]);
+        await db.execute(`DELETE FROM grimmory_note_links WHERE account = ? AND book_hash = ?`, [
+          account,
+          bookHash,
+        ]);
+      }),
+    );
+  }
+
+  getLinks(account: string, bookHash: string): Promise<GrimmoryNoteLink[]> {
+    return this.withDb(async (db) => {
+      const rows = await db.select<LinkRow>(
+        `SELECT note_id, kind, server_id, local_updated_at FROM grimmory_note_links
+         WHERE account = ? AND book_hash = ?`,
+        [account, bookHash],
+      );
+      return rows.map((row) => ({
+        noteId: row.note_id,
+        kind: row.kind as GrimmoryNoteKind,
+        serverId: Number(row.server_id),
+        localUpdatedAt: Number(row.local_updated_at),
+      }));
+    });
+  }
+
+  /**
+   * Replace every link of one kind for a book, all or nothing: the planner
+   * reads a missing link as "never synced".
+   */
+  setLinks(
+    account: string,
+    bookHash: string,
+    kind: GrimmoryNoteKind,
+    links: GrimmoryNoteLink[],
+  ): Promise<void> {
+    return this.withDb((db) =>
+      GrimmorySyncStore.inTransaction(db, async () => {
+        await db.execute(
+          `DELETE FROM grimmory_note_links WHERE account = ? AND book_hash = ? AND kind = ?`,
+          [account, bookHash, kind],
+        );
+        for (const link of links) {
+          await db.execute(
+            `INSERT OR REPLACE INTO grimmory_note_links
+               (account, book_hash, note_id, kind, server_id, local_updated_at)
+             VALUES (?, ?, ?, ?, ?, ?)`,
+            [account, bookHash, link.noteId, kind, link.serverId, link.localUpdatedAt],
+          );
+        }
+      }),
+    );
+  }
+}
diff --git a/apps/readest-app/src/services/grimmory/bookMatch.ts b/apps/readest-app/src/services/grimmory/bookMatch.ts
new file mode 100644
--- /dev/null
+++ b/apps/readest-app/src/services/grimmory/bookMatch.ts
@@ -0,0 +1,96 @@
+import { md5, partialMD5Ranges } from '@/utils/md5';
+import type { GrimmoryClient } from './GrimmoryClient';
+import type { GrimmoryBookMatch, GrimmorySyncStore } from './GrimmorySyncStore';
+import type { GrimmoryBookFile } from './types';
+
+type MatchClient = Pick<GrimmoryClient, 'listBooks' | 'readContent'>;
+type MatchStore = Pick<GrimmorySyncStore, 'getBook' | 'setBook'>;
+
+/**
+ * Grimmory names its files by the same KOReader partial MD5 Readest uses as
+ * Book.hash, but no endpoint looks a book up by it. Its book list does give
+ * each file's size, so a file of the right size is read back in the dozen 1 KB
+ * ranges the hash covers and hashed here.
+ */
+export const remotePartialMD5 = async (
+  client: Pick<GrimmoryClient, 'readContent'>,
+  bookId: number,
+  file: GrimmoryBookFile,
+  fileSize: number,
+): Promise<string> => {
+  const chunks = await Promise.all(
+    partialMD5Ranges(fileSize).map(([start, end]) =>
+      client.readContent(bookId, file.bookType, start, end),
+    ),
+  );
+  const hasher = md5.create();
+  for (const chunk of chunks) hasher.update(chunk);
+  return hasher.hex();
+};
+
+export const findGrimmoryBook = async (
+  client: MatchClient,
+  local: { hash: string; fileSize: number },
+): Promise<GrimmoryBookMatch | null> => {
+  const sizeKb = Math.floor(local.fileSize / 1024);
+  const books = await client.listBooks();
+  for (const book of books) {
+    const files: [GrimmoryBookFile | null | undefined, boolean][] = [
+      [book.primaryFile, true],
+      ...(book.alternativeFormats ?? []).map((file): [GrimmoryBookFile, boolean] => [file, false]),
+    ];
+    for (const [file, isPrimary] of files) {
+      if (!file || file.fileSizeKb !== sizeKb) continue;
+      if ((await remotePartialMD5(client, book.id, file, local.fileSize)) !== local.hash) continue;
+      return {
+        bookId: book.id,
+        bookFileId: file.id,
+        bookType: file.bookType ?? null,
+        isPrimary,
+        statusPushedAt: 0,
+      };
+    }
+  }
+  return null;
+};
+
+// A book not on the server is looked for again after this long, so adding it
+// to Grimmory later doesn't need an app restart.
+const MISS_TTL_MS = 10 * 60 * 1000;
+const misses = new Map<string, number>();
+const inFlight = new Map<string, Promise<GrimmoryBookMatch | null>>();
+
+/**
+ * The Grimmory book a local book is, from the store or found on the server.
+ * Without the file size (no open file) only a stored match is returned.
+ */
+export const resolveGrimmoryBook = async (params: {
+  client: MatchClient;
+  store: MatchStore;
+  account: string;
+  hash: string;
+  fileSize?: number;
+}): Promise<GrimmoryBookMatch | null> => {
+  const { client, store, account, hash, fileSize } = params;
+  const stored = await store.getBook(account, hash);
+  if (stored || !fileSize) return stored;
+
+  const key = `${account}|${hash}`;
+  const missedAt = misses.get(key);
+  if (missedAt && Date.now() - missedAt < MISS_TTL_MS) return null;
+  const pending = inFlight.get(key);
+  if (pending) return pending;
+
+  const lookup = (async () => {
+    const found = await findGrimmoryBook(client, { hash, fileSize });
+    if (found) {
+      await store.setBook(account, hash, found);
+      misses.delete(key);
+    } else {
+      misses.set(key, Date.now());
+    }
+    return found;
+  })().finally(() => inFlight.delete(key));
+  inFlight.set(key, lookup);
+  return lookup;
+};
diff --git a/apps/readest-app/src/services/grimmory/notesPass.ts b/apps/readest-app/src/services/grimmory/notesPass.ts
new file mode 100644
--- /dev/null
+++ b/apps/readest-app/src/services/grimmory/notesPass.ts
@@ -0,0 +1,206 @@
+import type { BookNote, ReadingStatus } from '@/types/book';
+import { resolveGrimmoryBook } from './bookMatch';
+import { GrimmoryRequestError, type GrimmoryClient } from './GrimmoryClient';
+import type { GrimmoryBookMatch, GrimmorySyncStore } from './GrimmorySyncStore';
+import {
+  annotationCreateBody,
+  annotationToRemoteNote,
+  annotationUpdateBody,
+  bookmarkCreateBody,
+  bookmarkToRemoteNote,
+  bookmarkUpdateBody,
+  planNotesSync,
+  type GrimmoryNoteKind,
+  type GrimmoryNoteLink,
+  type HighlightPalette,
+  type RemoteNote,
+} from './notesSync';
+import type { GrimmoryReadStatus } from './types';
+
+const READ_STATUS: Record<ReadingStatus, GrimmoryReadStatus> = {
+  unread: 'UNREAD',
+  reading: 'READING',
+  finished: 'READ',
+  abandoned: 'PAUSED',
+};
+
+/** Notes that went each way in one pass. */
+export interface GrimmoryPassCounts {
+  pushed: number;
+  pulled: number;
+  /** The server doesn't have this book. */
+  unmatched?: boolean;
+}
+
+export interface GrimmoryPassDeps {
+  client: Pick<
+    GrimmoryClient,
+    | 'listBooks'
+    | 'readContent'
+    | 'getAnnotations'
+    | 'createAnnotation'
+    | 'updateAnnotation'
+    | 'deleteAnnotation'
+    | 'getBookmarks'
+    | 'createBookmark'
+    | 'updateBookmark'
+    | 'deleteBookmark'
+    | 'updateReadStatus'
+  >;
+  store: Pick<GrimmorySyncStore, 'getBook' | 'setBook' | 'deleteBook' | 'getLinks' | 'setLinks'>;
+  account: string;
+  book: {
+    hash: string;
+    fileSize?: number;
+    readingStatus?: ReadingStatus;
+    readingStatusUpdatedAt?: number;
+  };
+  /** Highlights and bookmarks sync for reflowable books only; CFIs of a PDF differ. */
+  syncNotes: boolean;
+  syncBookStates: boolean;
+  /** Every note of the book, tombstones included. */
+  getNotes: () => BookNote[];
+  /** Merge notes by id and tombstone the listed ids. */
+  mergeNotes: (upserts: BookNote[], deleteNoteIds: string[]) => void;
+  chapterForNote: (note: BookNote) => string | undefined;
+  palette: HighlightPalette;
+  now: () => number;
+  newId: () => string;
+  onUnmatched: () => void;
+}
+
+const isStatus = (error: unknown, status: number) =>
+  error instanceof GrimmoryRequestError && error.status === status;
+
+const syncKind = async (
+  deps: GrimmoryPassDeps,
+  match: GrimmoryBookMatch,
+  kind: GrimmoryNoteKind,
+  counts: GrimmoryPassCounts,
+): Promise<void> => {
+  const { client, store, account, palette } = deps;
+  const { hash } = deps.book;
+  const remote: RemoteNote[] =
+    kind === 'annotation'
+      ? (await client.getAnnotations(match.bookId)).map((a) => annotationToRemoteNote(a, palette))
+      : (await client.getBookmarks(match.bookId))
+          .map(bookmarkToRemoteNote)
+          .filter((note): note is RemoteNote => !!note);
+  const links = (await store.getLinks(account, hash)).filter((link) => link.kind === kind);
+  const plan = planNotesSync({
+    kind,
+    notes: deps.getNotes(),
+    remote,
+    links,
+    palette,
+    now: deps.now(),
+    newId: deps.newId,
+  });
+
+  if (plan.upsertLocal.length > 0 || plan.deleteLocal.length > 0) {
+    deps.mergeNotes(plan.upsertLocal, plan.deleteLocal);
+    counts.pulled += plan.upsertLocal.length + plan.deleteLocal.length;
+  }
+
+  // An edit stays marked as unsent (localUpdatedAt 0) until the server takes
+  // it, so a pass that stops early sends it next time instead of letting the
+  // server copy overwrite it.
+  const pending = new Set(plan.updateRemote.map(({ note }) => note.id));
+  const nextLinks: GrimmoryNoteLink[] = plan.links.map((link) =>
+    pending.has(link.noteId) ? { ...link, localUpdatedAt: 0 } : link,
+  );
+  try {
+    for (const serverId of plan.deleteRemote) {
+      if (kind === 'annotation') await client.deleteAnnotation(serverId);
+      else await client.deleteBookmark(serverId);
+      counts.pushed++;
+    }
+    for (const { note, serverId } of plan.updateRemote) {
+      try {
+        if (kind === 'annotation') {
+          await client.updateAnnotation(serverId, annotationUpdateBody(note, palette));
+        } else {
+          await client.updateBookmark(serverId, bookmarkUpdateBody(note));
+        }
+        counts.pushed++;
+        const link = nextLinks.find((l) => l.noteId === note.id);
+        if (link) link.localUpdatedAt = note.updatedAt;
+      } catch (error) {
+        if (isStatus(error, 401)) throw error;
+        console.warn('[Grimmory] update failed', error);
+      }
+    }
+    for (const note of plan.createRemote) {
+      try {
+        if (kind === 'annotation') {
+          const body = annotationCreateBody(match.bookId, note, palette, deps.chapterForNote(note));
+          const created = await client.createAnnotation(body);
+          nextLinks.push({
+            noteId: note.id,
+            kind,
+            serverId: created.id,
+            localUpdatedAt: note.updatedAt,
+          });
+        } else {
+          const created = await client.createBookmark(bookmarkCreateBody(match.bookId, note));
+          // A new bookmark takes no notes, so they follow in an update.
+          if (note.note) await client.updateBookmark(created.id, bookmarkUpdateBody(note));
+          nextLinks.push({
+            noteId: note.id,
+            kind,
+            serverId: created.id,
+            localUpdatedAt: note.updatedAt,
+          });
+        }
+        counts.pushed++;
+      } catch (error) {
+        if (isStatus(error, 401)) throw error;
+        // 409: created at this CFI by another client meanwhile; the next pass
+        // pairs the two. Anything else is retried by the next pass.
+        if (!isStatus(error, 409)) console.warn('[Grimmory] create failed', error);
+      }
+    }
+  } finally {
+    await store.setLinks(account, hash, kind, nextLinks);
+  }
+};
+
+/**
+ * One Grimmory pass for an open book: find it on the server, sync its
+ * highlights and bookmarks both ways, and send its reading status.
+ */
+export const runGrimmoryPass = async (
+  deps: GrimmoryPassDeps,
+  counts: GrimmoryPassCounts = { pushed: 0, pulled: 0 },
+): Promise<GrimmoryPassCounts> => {
+  const { client, store, account, book } = deps;
+  const match = await resolveGrimmoryBook({
+    client,
+    store,
+    account,
+    hash: book.hash,
+    fileSize: book.fileSize,
+  });
+  if (!match) {
+    deps.onUnmatched();
+    counts.unmatched = true;
+    return counts;
+  }
+
+  try {
+    if (deps.syncNotes) {
+      await syncKind(deps, match, 'annotation', counts);
+      await syncKind(deps, match, 'bookmark', counts);
+    }
+    const statusAt = book.readingStatusUpdatedAt ?? 0;
+    if (deps.syncBookStates && book.readingStatus && statusAt > match.statusPushedAt) {
+      await client.updateReadStatus(match.bookId, READ_STATUS[book.readingStatus]);
+      await store.setBook(account, book.hash, { ...match, statusPushedAt: statusAt });
+    }
+  } catch (error) {
+    // The book was removed from Grimmory: forget it so the next pass looks again.
+    if (isStatus(error, 404)) await store.deleteBook(account, book.hash);
+    throw error;
+  }
+  return counts;
+};
diff --git a/apps/readest-app/src/services/grimmory/notesSync.ts b/apps/readest-app/src/services/grimmory/notesSync.ts
new file mode 100644
--- /dev/null
+++ b/apps/readest-app/src/services/grimmory/notesSync.ts
@@ -0,0 +1,313 @@
+import type { BookNote, HighlightColor, HighlightStyle } from '@/types/book';
+import type { GrimmoryAnnotation, GrimmoryAnnotationStyle, GrimmoryBookmark } from './types';
+
+/**
+ * Two-way highlight and bookmark sync with Grimmory, planned without I/O.
+ *
+ * Grimmory keeps no tombstones, so a note's link to its server copy is kept
+ * locally (GrimmorySyncStore): a linked note whose server copy is gone was
+ * deleted on another client, and a linked note tombstoned here is deleted on
+ * the server. Unlinked notes on both sides pair up by CFI — Grimmory's web
+ * reader is foliate-js, so the same selection yields the same CFI.
+ *
+ * Grimmory's timestamps carry no time zone, so they are only compared with
+ * themselves, never with Readest's clock. When both sides differ, the side
+ * edited here since the last pass wins; otherwise the server's copy does.
+ */
+
+export type GrimmoryNoteKind = 'annotation' | 'bookmark';
+
+export interface GrimmoryNoteLink {
+  noteId: string;
+  kind: GrimmoryNoteKind;
+  serverId: number;
+  /** The local note's updatedAt when the two last matched. */
+  localUpdatedAt: number;
+}
+
+/** A server item in local terms, for both kinds. */
+export interface RemoteNote {
+  id: number;
+  cfi: string;
+  text: string;
+  note: string;
+  color?: HighlightColor;
+  style?: HighlightStyle;
+  chapter?: string;
+  /** Epoch ms, read as UTC; only used against a local tombstone. */
+  createdAt?: number;
+}
+
+export interface NotesPlan {
+  createRemote: BookNote[];
+  updateRemote: { note: BookNote; serverId: number }[];
+  deleteRemote: number[];
+  upsertLocal: BookNote[];
+  deleteLocal: string[];
+  /** Links that hold after this plan, before the server answers creations. */
+  links: GrimmoryNoteLink[];
+}
+
+/** Palette name -> hex, e.g. { yellow: '#facc15' }. */
+export type HighlightPalette = Record<string, string>;
+
+const HEX_COLOR = /^#[0-9a-f]{6}$/i;
+export const MAX_ANNOTATION_CFI = 1000;
+export const MAX_BOOKMARK_CFI = 500;
+const MAX_TEXT = 5000;
+const MAX_ANNOTATION_NOTE = 5000;
+const MAX_BOOKMARK_TITLE = 255;
+const MAX_BOOKMARK_NOTES = 2000;
+
+/** Readest color (palette name or hex) as Grimmory's #RRGGBB, if it has one. */
+export const colorToGrimmory = (
+  color: HighlightColor | undefined,
+  palette: HighlightPalette,
+): string | undefined => {
+  if (!color) return undefined;
+  const hex = palette[color] ?? color;
+  return HEX_COLOR.test(hex) ? hex.toUpperCase() : undefined;
+};
+
+/** Grimmory's #RRGGBB as a palette name when it is one, else the hex itself. */
+export const colorFromGrimmory = (
+  color: string | null | undefined,
+  palette: HighlightPalette,
+): HighlightColor | undefined => {
+  if (!color || !HEX_COLOR.test(color)) return undefined;
+  const lower = color.toLowerCase();
+  const name = Object.keys(palette).find((key) => palette[key]?.toLowerCase() === lower);
+  return name ?? lower;
+};
+
+// Readest has no strikethrough; it reads as an underline.
+export const styleFromGrimmory = (
+  style: GrimmoryAnnotationStyle | null | undefined,
+): HighlightStyle | undefined =>
+  style === 'strikethrough' ? 'underline' : (style ?? undefined) || undefined;
+
+/** Grimmory's zone-less datetime, read as UTC. */
+export const parseGrimmoryDatetime = (value: string | null | undefined): number | undefined => {
+  if (!value) return undefined;
+  const ms = Date.parse(/[zZ]|[+-]\d\d:\d\d$/.test(value) ? value : `${value}Z`);
+  return Number.isFinite(ms) ? ms : undefined;
+};
+
+export const annotationToRemoteNote = (
+  annotation: GrimmoryAnnotation,
+  palette: HighlightPalette,
+): RemoteNote => ({
+  id: annotation.id,
+  cfi: annotation.cfi,
+  text: annotation.text ?? '',
+  note: annotation.note ?? '',
+  color: colorFromGrimmory(annotation.color, palette),
+  style: styleFromGrimmory(annotation.style),
+  chapter: annotation.chapterTitle ?? undefined,
+  createdAt: parseGrimmoryDatetime(annotation.createdAt),
+});
+
+/** Null when the bookmark has no CFI (a PDF page or an audiobook position). */
+export const bookmarkToRemoteNote = (bookmark: GrimmoryBookmark): RemoteNote | null =>
+  bookmark.cfi
+    ? {
+        id: bookmark.id,
+        cfi: bookmark.cfi,
+        text: bookmark.title ?? '',
+        note: bookmark.notes ?? '',
+        createdAt: parseGrimmoryDatetime(bookmark.createdAt),
+      }
+    : null;
+
+/** Notes of this kind that Grimmory can hold. */
+export const isSyncableNote = (note: BookNote, kind: GrimmoryNoteKind): boolean => {
+  if (note.type !== kind || !note.cfi) return false;
+  if (kind === 'bookmark') return note.cfi.length <= MAX_BOOKMARK_CFI;
+  // Grimmory requires the highlighted text; handwriting has no place there.
+  return !!note.text && !note.ink?.length && note.cfi.length <= MAX_ANNOTATION_CFI;
+};
+
+/** The fields both sides can edit, in local terms as they would be stored remotely. */
+const editableFields = (
+  kind: GrimmoryNoteKind,
+  note: Pick<BookNote, 'text' | 'note' | 'color' | 'style'>,
+  palette: HighlightPalette,
+): string =>
+  kind === 'bookmark'
+    ? JSON.stringify([
+        (note.text ?? '').slice(0, MAX_BOOKMARK_TITLE),
+        (note.note ?? '').slice(0, MAX_BOOKMARK_NOTES),
+      ])
+    : JSON.stringify([
+        (note.note ?? '').slice(0, MAX_ANNOTATION_NOTE),
+        colorToGrimmory(note.color, palette) ?? '',
+        note.style ?? 'highlight',
+      ]);
+
+const fromRemote = (
+  kind: GrimmoryNoteKind,
+  remote: RemoteNote,
+  base: BookNote | undefined,
+  id: string,
+  now: number,
+): BookNote => {
+  if (base) {
+    return kind === 'bookmark'
+      ? { ...base, text: remote.text, note: remote.note, updatedAt: now }
+      : {
+          ...base,
+          note: remote.note,
+          color: remote.color ?? base.color,
+          style: remote.style ?? base.style,
+          updatedAt: now,
+        };
+  }
+  return {
+    id,
+    type: kind,
+    cfi: remote.cfi,
+    text: remote.text,
+    note: remote.note,
+    ...(kind === 'annotation'
+      ? { style: remote.style ?? 'highlight', color: remote.color ?? 'yellow' }
+      : {}),
+    createdAt: remote.createdAt ?? now,
+    updatedAt: now,
+  };
+};
+
+export const planNotesSync = (params: {
+  kind: GrimmoryNoteKind;
+  /** Every local note of the book, tombstones included. */
+  notes: BookNote[];
+  remote: RemoteNote[];
+  links: GrimmoryNoteLink[];
+  palette: HighlightPalette;
+  now: number;
+  newId: () => string;
+}): NotesPlan => {
+  const { kind, palette, now } = params;
+  const plan: NotesPlan = {
+    createRemote: [],
+    updateRemote: [],
+    deleteRemote: [],
+    upsertLocal: [],
+    deleteLocal: [],
+    links: [],
+  };
+  const notes = params.notes.filter((note) => isSyncableNote(note, kind));
+  const notesById = new Map(notes.map((note) => [note.id, note]));
+  const remoteById = new Map(params.remote.map((remote) => [remote.id, remote]));
+  const linkedNoteIds = new Set<string>();
+  const linkedServerIds = new Set<number>();
+
+  const reconcile = (local: BookNote, remote: RemoteNote, localChanged: boolean) => {
+    if (editableFields(kind, local, palette) === editableFields(kind, remote, palette)) {
+      plan.links.push({
+        noteId: local.id,
+        kind,
+        serverId: remote.id,
+        localUpdatedAt: local.updatedAt,
+      });
+    } else if (localChanged) {
+      plan.updateRemote.push({ note: local, serverId: remote.id });
+      plan.links.push({
+        noteId: local.id,
+        kind,
+        serverId: remote.id,
+        localUpdatedAt: local.updatedAt,
+      });
+    } else {
+      plan.upsertLocal.push(fromRemote(kind, remote, local, local.id, now));
+      plan.links.push({ noteId: local.id, kind, serverId: remote.id, localUpdatedAt: now });
+    }
+  };
+
+  for (const link of params.links) {
+    if (link.kind !== kind) continue;
+    const local = notesById.get(link.noteId);
+    const remote = remoteById.get(link.serverId);
+    linkedNoteIds.add(link.noteId);
+    if (remote) linkedServerIds.add(remote.id);
+    if (!remote) {
+      // Deleted on the server or another client.
+      if (local && !local.deletedAt) plan.deleteLocal.push(local.id);
+    } else if (local?.deletedAt) {
+      plan.deleteRemote.push(remote.id);
+    } else if (!local) {
+      // The local copy is gone without a tombstone (a re-imported book):
+      // restore it under its old id rather than delete it everywhere.
+      plan.upsertLocal.push(fromRemote(kind, remote, undefined, link.noteId, now));
+      plan.links.push({ noteId: link.noteId, kind, serverId: remote.id, localUpdatedAt: now });
+    } else {
+      reconcile(local, remote, local.updatedAt > link.localUpdatedAt);
+    }
+  }
+
+  const unlinkedLocal = notes.filter((note) => !linkedNoteIds.has(note.id));
+  const pairedLocal = new Set<string>();
+  for (const remote of params.remote) {
+    if (linkedServerIds.has(remote.id)) continue;
+    const sameCfi = unlinkedLocal.filter(
+      (note) => note.cfi === remote.cfi && !pairedLocal.has(note.id),
+    );
+    const live = sameCfi.find((note) => !note.deletedAt);
+    if (live) {
+      pairedLocal.add(live.id);
+      // First pairing: this device's copy wins a difference.
+      reconcile(live, remote, true);
+      continue;
+    }
+    // Deleted here before it was ever linked, and not highlighted again since.
+    const tombstone = sameCfi.find(
+      (note) =>
+        note.deletedAt && (remote.createdAt === undefined || remote.createdAt <= note.deletedAt),
+    );
+    if (tombstone) {
+      pairedLocal.add(tombstone.id);
+      plan.deleteRemote.push(remote.id);
+      continue;
+    }
+    const note = fromRemote(kind, remote, undefined, params.newId(), now);
+    plan.upsertLocal.push(note);
+    plan.links.push({ noteId: note.id, kind, serverId: remote.id, localUpdatedAt: now });
+  }
+
+  for (const note of unlinkedLocal) {
+    if (!note.deletedAt && !pairedLocal.has(note.id)) plan.createRemote.push(note);
+  }
+  return plan;
+};
+
+export const annotationCreateBody = (
+  bookId: number,
+  note: BookNote,
+  palette: HighlightPalette,
+  chapter: string | undefined,
+) => ({
+  bookId,
+  cfi: note.cfi,
+  text: (note.text ?? '').slice(0, MAX_TEXT),
+  color: colorToGrimmory(note.color, palette),
+  style: note.style ?? 'highlight',
+  ...(note.note ? { note: note.note.slice(0, MAX_ANNOTATION_NOTE) } : {}),
+  ...(chapter ? { chapterTitle: chapter.slice(0, 500) } : {}),
+});
+
+export const annotationUpdateBody = (note: BookNote, palette: HighlightPalette) => ({
+  color: colorToGrimmory(note.color, palette),
+  style: note.style ?? 'highlight',
+  // An empty string clears the note; null would leave it unchanged.
+  note: (note.note ?? '').slice(0, MAX_ANNOTATION_NOTE),
+});
+
+export const bookmarkCreateBody = (bookId: number, note: BookNote) => ({
+  bookId,
+  cfi: note.cfi,
+  ...(note.text ? { title: note.text.slice(0, MAX_BOOKMARK_TITLE) } : {}),
+});
+
+export const bookmarkUpdateBody = (note: BookNote) => ({
+  title: (note.text ?? '').slice(0, MAX_BOOKMARK_TITLE),
+  notes: (note.note ?? '').slice(0, MAX_BOOKMARK_NOTES),
+});
