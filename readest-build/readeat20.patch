+  generation: number;
+  key?: string;
+  requestId?: number;
+  turnId?: number;
+  released?: boolean;
+  destination?: string;
+  x?: number;
+  y?: number;
+  width?: number;
+  height?: number;
+  forward?: boolean;
+  rtl?: boolean;
+  progress?: number;
+  grabY?: number;
+  commit?: boolean;
+  velocity?: number;
+  columns?: number;
+  flip?: boolean;
+}
