+    const swing = swingAngle / Math.PI;
+    const landingStart = swing / (swing + 1);
+    if (desired <= Math.PI - GESTURE_HINGE_BEND_AMPLITUDE && swingAngle > 1e-9)
+      return landingStart * ((desired - HINGE_ROTATION) / swingAngle);
