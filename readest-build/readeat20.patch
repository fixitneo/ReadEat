+    vi.restoreAllMocks();
+  });
+
+  test('records the config it pushed under its backend', async () => {
+    renderHook(() => useFileSync('k'));
+
+    await waitFor(() => expect(h.pushBookConfig).toHaveBeenCalled());
+    await waitFor(() =>
+      expect(readFlowState().entries[0]).toMatchObject({
+        connector: 'webdav',
+        direction: 'push',
+        kind: 'progress',
+        count: 1,
+        bookTitle: 'Dune',
+      }),
+    );
+  });
+
+  test('does not count a pull that changed nothing, though it shows the sync worked', async () => {
+    h.pullBookConfig.mockResolvedValue({ applied: true, changed: false, mergedConfig: {} });
+    renderHook(() => useFileSync('k'));
+
+    await waitFor(() =>
+      expect(readFlowState().totals['webdav:pull:progress']?.lastSuccessAt).toBeGreaterThan(0),
+    );
+    expect(readFlowState().totals['webdav:pull:progress']?.count).toBe(0);
+  });
+
+  test('records a pull that applied a newer config', async () => {
+    h.pullBookConfig.mockResolvedValue({ applied: true, changed: true, mergedConfig: {} });
+    renderHook(() => useFileSync('k'));
+
+    await waitFor(() =>
+      expect(readFlowState().entries.find((e) => e.direction === 'pull')).toMatchObject({
+        connector: 'webdav',
+        count: 1,
+      }),
+    );
+  });
+
+  test('records a failed pull', async () => {
+    h.pullBookConfig.mockRejectedValue(new Error('403 Forbidden'));
+    renderHook(() => useFileSync('k'));
+
+    await waitFor(() =>
+      expect(readFlowState().entries.find((e) => e.direction === 'pull')).toMatchObject({
+        error: '403 Forbidden',
+      }),
+    );
+  });
+
+  test('records a failed push', async () => {
+    h.pushBookConfig.mockRejectedValue(new Error('507 Insufficient Storage'));
+    renderHook(() => useFileSync('k'));
+
+    await waitFor(() =>
+      expect(readFlowState().entries.find((e) => e.error)).toMatchObject({
+        direction: 'push',
+        error: '507 Insufficient Storage',
+      }),
+    );
+  });
+});
