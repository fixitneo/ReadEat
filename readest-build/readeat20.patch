+}));
+vi.mock('@/context/EnvContext', () => ({
+  useEnv: () => ({ appService: { isMobile: false } }),
+}));
+const setHoveredBookKey = vi.hoisted(() => vi.fn());
+vi.mock('@/store/readerStore', () => ({
+  useReaderStore: () => ({
+    hoveredBookKey: 'book-1',
+    setHoveredBookKey,
