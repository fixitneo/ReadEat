+  });
+
+  it('falls back to the page-pair percent before the first relocate reports a fraction', () => {
+    expect(formatProgressPercent(undefined, 344, 1000)).toBe('34.5%');
+    expect(formatProgressPercent(undefined, 34, 80)).toBe('44%');
+    expect(formatProgressPercent(NaN, 344, 1000)).toBe('34.5%');
+  });
+
+  it('returns an empty string without a valid total', () => {
+    expect(formatProgressPercent(0.5, 0, undefined)).toBe('');
+    expect(formatProgressPercent(0.5, 0, 0)).toBe('');
+  });
+});
diff --git a/apps/readest-app/src/__tests__/utils/public-fetch.test.ts b/apps/readest-app/src/__tests__/utils/public-fetch.test.ts
new file mode 100644
--- /dev/null
+++ b/apps/readest-app/src/__tests__/utils/public-fetch.test.ts
@@ -0,0 +1,181 @@
+// @vitest-environment node
+import { afterAll, beforeAll, describe, expect, it, vi } from 'vitest';
+import http from 'node:http';
+import dns from 'node:dns';
+import zlib from 'node:zlib';
+import type { AddressInfo } from 'node:net';
+import { createPublicLookup, fetchWithLookup, publicFetch } from '@/utils/publicFetch';
+
+type LookupResult = { address: string; family: number }[];
+
+// A stand-in resolver that answers every name with the given records, the way
+// an attacker-controlled DNS zone would.
+const resolvingTo = (records: LookupResult): typeof dns.lookup =>
+  ((_hostname: string, _options: unknown, callback: (...args: unknown[]) => void) =>
+    callback(null, records)) as unknown as typeof dns.lookup;
+
+const lookupWith = (lookup: ReturnType<typeof createPublicLookup>, all: boolean) =>
+  new Promise<{ err: NodeJS.ErrnoException | null; address: unknown; family?: number }>((resolve) =>
+    lookup('catalog.example', { all }, (err, address, family) => resolve({ err, address, family })),
+  );
+
+describe('createPublicLookup', () => {
+  it('rejects a public name whose records point at loopback', async () => {
+    const lookup = createPublicLookup(resolvingTo([{ address: '127.0.0.1', family: 4 }]));
+    const { err } = await lookupWith(lookup, false);
+    expect(err?.code).toBe('EBLOCKEDADDRESS');
+  });
+
+  it('rejects when any of several records is internal', async () => {
+    const lookup = createPublicLookup(
+      resolvingTo([
+        { address: '93.184.215.14', family: 4 },
+        { address: 'fd00::1', family: 6 },
+      ]),
+    );
+    const { err } = await lookupWith(lookup, true);
+    expect(err?.code).toBe('EBLOCKEDADDRESS');
+  });
+
+  it('rejects cloud metadata and IPv4-mapped loopback records', async () => {
+    for (const address of ['169.254.169.254', '::ffff:127.0.0.1']) {
+      const lookup = createPublicLookup(resolvingTo([{ address, family: 4 }]));
+      const { err } = await lookupWith(lookup, false);
+      expect(err?.code).toBe('EBLOCKEDADDRESS');
+    }
+  });
+
+  it('passes public records through in the shape the caller asked for', async () => {
+    const records = [
+      { address: '93.184.215.14', family: 4 },
+      { address: '2606:2800:21f:cb07:6820:80da:af6b:8b2c', family: 6 },
+    ];
+    const lookup = createPublicLookup(resolvingTo(records));
+    expect(await lookupWith(lookup, true)).toEqual({ err: null, address: records });
+    expect(await lookupWith(lookup, false)).toEqual({
+      err: null,
+      address: '93.184.215.14',
+      family: 4,
+    });
+  });
+});
+
+describe('publicFetch on a Node server', () => {
+  it('refuses a hostname that resolves to an internal address', async () => {
+    const lookupSpy = vi
+      .spyOn(dns, 'lookup')
+      .mockImplementation(resolvingTo([{ address: '127.0.0.1', family: 4 }]));
+    await expect(publicFetch('http://rebind.example:9/feed', {})).rejects.toThrow(
+      /internal address/,
+    );
+    expect(lookupSpy).toHaveBeenCalled();
+    lookupSpy.mockRestore();
+  });
+
+  it('refuses an internal host literal before resolving anything', async () => {
+    const lookupSpy = vi.spyOn(dns, 'lookup');
+    await expect(publicFetch('http://169.254.169.254/latest', {})).rejects.toThrow(
+      /internal address/,
+    );
+    expect(lookupSpy).not.toHaveBeenCalled();
+    lookupSpy.mockRestore();
+  });
+});
+
+describe('fetchWithLookup', () => {
+  let server: http.Server;
+  let base: string;
+
+  beforeAll(async () => {
+    server = http.createServer((req, res) => {
+      if (req.url === '/stall') {
+        return; // accept the request and never answer
+      } else if (req.url === '/redirect') {
+        res.writeHead(302, { Location: '/target' });
+        res.end();
+      } else if (req.url === '/gzip') {
+        res.writeHead(200, { 'Content-Type': 'text/xml', 'Content-Encoding': 'gzip' });
+        res.end(zlib.gzipSync('<feed/>'));
+      } else if (req.url === '/echo') {
+        let body = '';
+        req.on('data', (chunk) => (body += chunk));
+        req.on('end', () => {
+          res.writeHead(201, { 'Content-Type': 'application/json', 'Set-Cookie': ['a=1', 'b=2'] });
+          res.end(
+            JSON.stringify({
+              method: req.method,
+              body,
+              auth: req.headers['authorization'] ?? null,
+              length: req.headers['content-length'] ?? null,
+            }),
+          );
+        });
+      } else {
+        res.writeHead(200, { 'Content-Type': 'text/plain', 'Content-Length': '5' });
+        res.end(req.method === 'HEAD' ? undefined : 'hello');
+      }
+    });
+    await new Promise<void>((resolve) => server.listen(0, '127.0.0.1', resolve));
+    base = `http://localhost:${(server.address() as AddressInfo).port}`;
+  });
+
+  afterAll(() => {
+    server.closeAllConnections();
+    return new Promise<void>((resolve) => server.close(() => resolve()));
+  });
+
+  it('sends the method, headers and body and returns status, headers and body', async () => {
+    const res = await fetchWithLookup(
+      `${base}/echo`,
+      { method: 'POST', headers: { Authorization: 'Basic abc' }, body: '{"x":1}' },
+      dns.lookup,
+    );
+    expect(res.status).toBe(201);
+    expect(res.headers.get('content-type')).toBe('application/json');
+    expect(res.headers.getSetCookie()).toEqual(['a=1', 'b=2']);
+    expect(await res.json()).toEqual({
+      method: 'POST',
+      body: '{"x":1}',
+      auth: 'Basic abc',
+      length: '7',
+    });
+  });
+
+  it('returns redirects instead of following them', async () => {
+    const res = await fetchWithLookup(`${base}/redirect`, {}, dns.lookup);
+    expect(res.status).toBe(302);
+    expect(res.headers.get('location')).toBe('/target');
+  });
+
+  it('decodes compressed bodies like fetch does', async () => {
+    const res = await fetchWithLookup(`${base}/gzip`, {}, dns.lookup);
+    expect(await res.text()).toBe('<feed/>');
+  });
+
+  it('returns an empty body for HEAD', async () => {
+    const res = await fetchWithLookup(`${base}/plain`, { method: 'HEAD' }, dns.lookup);
+    expect(res.status).toBe(200);
+    expect(res.headers.get('content-length')).toBe('5');
+    expect(res.body).toBeNull();
+  });
+
+  it('honors an abort signal', async () => {
+    const controller = new AbortController();
+    controller.abort();
+    await expect(
+      fetchWithLookup(`${base}/plain`, { signal: controller.signal }, dns.lookup),
+    ).rejects.toThrow();
+  });
+
+  it('gives up on a server that stops responding', async () => {
+    await expect(
+      fetchWithLookup(`${base}/stall`, { idleTimeoutMs: 50 }, dns.lookup),
+    ).rejects.toThrow(/timed out/);
+  });
+
+  it('refuses to connect when the resolver reports an internal address', async () => {
+    await expect(
+      fetchWithLookup(`${base}/plain`, {}, createPublicLookup(dns.lookup)),
+    ).rejects.toThrow(/internal address/);
+  });
+});
diff --git a/apps/readest-app/src/__tests__/utils/publisher-fonts.browser.test.ts b/apps/readest-app/src/__tests__/utils/publisher-fonts.browser.test.ts
new file mode 100644
--- /dev/null
+++ b/apps/readest-app/src/__tests__/utils/publisher-fonts.browser.test.ts
@@ -0,0 +1,162 @@
+// "Ignore publisher font names" (#7276): a book list such as
+// `Palatino, serif` names fonts ahead of the generic, so the reader's serif
+// font was never reached. With the category's switch on, the list resolves to
+// the reader's font; with it off, the book's list renders as before.
+import { afterEach, describe, expect, it } from 'vitest';
+import { getStyles, transformStylesheet } from '@/utils/style';
+import { styleTransformer } from '@/services/transformers/style';
+import {
+  DEFAULT_BOOK_FONT,
+  DEFAULT_BOOK_LAYOUT,
+  DEFAULT_BOOK_STYLE,
+  DEFAULT_VIEW_CONFIG,
+} from '@/services/constants';
+import type { ViewSettings } from '@/types/book';
+import type { TransformContext } from '@/services/transformers/types';
+
+const frames: HTMLIFrameElement[] = [];
+afterEach(() => {
+  for (const frame of frames.splice(0)) frame.remove();
+});
+
+const BOOK_CSS = `
+  body { font-family: serif; }
+  #serif { font-family: PublisherSerif, "Publisher Two", serif !important; }
+  #sans { font: italic 20px/1.5 PublisherSans, sans-serif; }
+  #mono { font-family: PublisherMono, monospace; }
+  #decorative { font-family: Decorative, fantasy; }
+  #quoted { font-family: "Decorative, serif, ornaments", fantasy; }
+  #commented { font-family: PublisherSerif, /* fallback */ serif; }
+  #mixed { font-family: PublisherMixed, serif, monospace; }
+  #mixed-short { font: 16px PublisherMixed, serif, monospace; }
+`;
+
+const BODY =
+  '<p id="serif">a</p><p id="sans">b</p><p id="mono">c</p><p id="decorative">d</p>' +
+  '<p id="inline" style="font-family: &quot;Inline Serif&quot;, serif">e</p>' +
+  '<p id="apostrophe" style="font-family: &quot;O\'Neill&quot;, serif">h</p>' +
+  '<p id="inline-font" style=\'font: bold 1em "Inline Sans", sans-serif\'>f</p>' +
+  '<p id="plain">g</p><p id="quoted">i</p><p id="commented">j</p>' +
+  '<p id="mixed">k</p><p id="mixed-short">l</p>' +
+  '<p id="commented-inline" style="font-family: PublisherSerif, /* fallback */ serif">m</p>';
+
+const render = async () => {
+  const frame = document.createElement('iframe');
+  document.body.append(frame);
+  frames.push(frame);
+  const doc = frame.contentDocument!;
+  const book = doc.createElement('style');
+  // Transformed twice: a stylesheet can pass through the transform again (#5277).
+  book.textContent = transformStylesheet(
+    transformStylesheet(BOOK_CSS, 800, 600, false),
+    800,
+    600,
+    false,
+  );
+  doc.head.append(book);
+  doc.body.innerHTML = await styleTransformer.transform({
+    bookKey: 'book',
+    viewSettings: { vertical: false } as ViewSettings,
+    userLocale: 'en',
+    isFixedLayout: false,
+    width: 800,
+    height: 600,
+    content: BODY,
+    transformers: ['style'],
+  } satisfies TransformContext);
+  const reader = doc.createElement('style');
+  doc.head.append(reader);
+  const apply = (settings: Partial<ViewSettings>) => {
+    reader.textContent = getStyles({
+      ...DEFAULT_BOOK_FONT,
+      ...DEFAULT_BOOK_LAYOUT,
+      ...DEFAULT_BOOK_STYLE,
+      ...DEFAULT_VIEW_CONFIG,
+      serifFont: 'ReaderSerif',
+      sansSerifFont: 'ReaderSans',
+      monospaceFont: 'ReaderMono',
+      ...settings,
+    } as ViewSettings);
+  };
+  const style = (id: string) => frame.contentWindow!.getComputedStyle(doc.getElementById(id)!);
+  const font = (id: string) => style(id).fontFamily;
+  return { apply, font, style };
+};
+
+const IDS = ['serif', 'sans', 'mono', 'decorative', 'inline', 'apostrophe', 'inline-font', 'plain'];
+
+describe('Ignore publisher font names', () => {
+  it('keeps the book fonts while every switch is off', async () => {
+    const { apply, font } = await render();
+    apply({});
+    expect(font('serif')).toMatch(/^PublisherSerif, "Publisher Two", /);
+    expect(font('sans')).toMatch(/^PublisherSans, sans-serif$/);
+    expect(font('mono')).toMatch(/^PublisherMono, /);
+    expect(font('inline')).toMatch(/^"Inline Serif", serif$/);
+    expect(font('apostrophe')).toBe(`"O'Neill", serif`);
+    expect(font('inline-font')).toMatch(/^"Inline Sans", sans-serif$/);
+  });
+
+  it('swaps only the switched categories for the reader font, live', async () => {
+    const { apply, font } = await render();
+    apply({ ignorePublisherFonts: ['serif'] });
+    expect(font('serif')).toMatch(/^ReaderSerif,/);
+    expect(font('inline')).toMatch(/^ReaderSerif,/);
+    expect(font('apostrophe')).toMatch(/^ReaderSerif,/);
+    expect(font('sans')).toMatch(/^PublisherSans/);
+    expect(font('mono')).toMatch(/^PublisherMono/);
+
+    apply({ ignorePublisherFonts: ['sans-serif', 'monospace'] });
+    expect(font('serif')).toMatch(/^PublisherSerif/);
+    expect(font('sans')).toMatch(/^ReaderSans,/);
+    expect(font('inline-font')).toMatch(/^ReaderSans,/);
+    expect(font('mono')).toMatch(/^ReaderMono,/);
+    expect(font('decorative')).toBe('Decorative, fantasy');
+
+    apply({});
+    expect(font('sans')).toMatch(/^PublisherSans/);
+    expect(font('mono')).toMatch(/^PublisherMono/);
+  });
+
+  it('preserves quoted names and recognizes commented generic entries', async () => {
+    const { apply, font } = await render();
+    apply({});
+    expect(font('quoted')).toBe('"Decorative, serif, ornaments", fantasy');
+    expect(font('commented')).toMatch(/^PublisherSerif,/);
+    apply({ ignorePublisherFonts: ['serif'] });
+    expect(font('quoted')).toBe('"Decorative, serif, ornaments", fantasy');
+    expect(font('commented')).toMatch(/^ReaderSerif,/);
+    expect(font('commented-inline')).toMatch(/^ReaderSerif,/);
+  });
+
+  it('uses a later enabled category and restores mixed publisher lists', async () => {
+    const { apply, font } = await render();
+    for (const id of ['mixed', 'mixed-short']) {
+      apply({});
+      expect(font(id)).toMatch(/^PublisherMixed,/);
+      apply({ ignorePublisherFonts: ['monospace'] });
+      expect(font(id)).toMatch(/^ReaderMono,/);
+      apply({ ignorePublisherFonts: ['serif', 'monospace'] });
+      expect(font(id)).toMatch(/^ReaderSerif,/);
+      apply({});
+      expect(font(id)).toMatch(/^PublisherMixed,/);
+    }
+  });
+
+  it('keeps the rest of a font shorthand', async () => {
+    const { apply, style } = await render();
+    apply({ ignorePublisherFonts: ['sans-serif'] });
+    expect(style('sans').fontStyle).toBe('italic');
+    expect(style('sans').fontSize).toBe('20px');
+    expect(style('sans').lineHeight).toBe('30px');
+    expect(style('inline-font').fontWeight).toBe('700');
+  });
+
+  it('leaves Override Book Font in charge', async () => {
+    const { apply, font } = await render();
+    apply({ overrideFont: true });
+    const baseline = IDS.map(font);
+    apply({ overrideFont: true, ignorePublisherFonts: ['serif', 'sans-serif', 'monospace'] });
+    expect(IDS.map(font)).toEqual(baseline);
+  });
+});
