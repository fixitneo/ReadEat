+import { describe, expect, it } from 'vitest';
+import { firstSense, hintFromDictionary } from '@/services/vocabulary/hintSources';
+import type { DictionaryProvider } from '@/services/dictionaries/types';
+
+describe('firstSense', () => {
+  it('skips the headword and pronunciation lines and drops the part of speech', () => {
+    expect(
+      firstSense(
+        'serendipity\n/ˌserənˈdɪpəti/\nn. the occurrence of events by chance; luck',
+        'serendipity',
+      ),
+    ).toBe('the occurrence of events by chance');
+  });
+
+  it('keeps a cross-language gloss whole up to the first sense break', () => {
+    expect(
+      firstSense('Serendipity [ˌserənˈdɪpəti]\nn. 意外发现，机缘巧合；运气', 'serendipity'),
+    ).toBe('意外发现，机缘巧合');
+  });
+
+  it('strips sense numbers and bracketed labels', () => {
+    expect(firstSense('1. (noun) good fortune.', 'luck')).toBe('good fortune');
+  });
+
+  it('caps a long sense at a word boundary', () => {
+    const sense = firstSense(
+      'the faculty of making fortunate discoveries of things you were not looking for',
+      'x',
+    );
+    expect(sense.length).toBeLessThanOrEqual(40);
+    expect(sense.endsWith(' ')).toBe(false);
+    expect('the faculty of making fortunate discoveries'.startsWith(sense)).toBe(true);
+  });
+
+  it('returns an empty string when only the headword is there', () => {
+    expect(firstSense('serendipity', 'serendipity')).toBe('');
+  });
+});
+
+describe('hintFromDictionary', () => {
+  const provider = (id: string, text: string | null): DictionaryProvider => ({
+    id,
+    kind: 'stardict',
+    label: id,
+    lookup: async (_word, ctx) => {
+      if (text === null) return { ok: false, reason: 'empty' };
+      ctx.container.textContent = text;
+      return { ok: true };
+    },
+  });
+
+  it('uses the first dictionary that has the word', async () => {
+    const hint = await hintFromDictionary('luck', 'en', [
+      provider('a', null),
+      provider('b', 'luck\nn. good fortune'),
+      provider('c', 'luck\nn. chance'),
+    ]);
+    expect(hint).toBe('good fortune');
+  });
+
+  const htmlProvider = (html: string): DictionaryProvider => ({
+    id: 'html',
+    kind: 'stardict',
+    label: 'html',
+    lookup: async (_word, ctx) => {
+      ctx.container.innerHTML = html;
+      return { ok: true };
+    },
+  });
+
+  it('takes the first definition item without its examples', async () => {
+    const hint = await hintFromDictionary('serendipity', 'en', [
+      htmlProvider(
+        '<hgroup><h1>serendipity</h1><p>English</p></hgroup><h2>Noun</h2>' +
+          '<ol><li>An unsought, unintended discovery<ul><li>A happy example.</li></ul></li></ol>',
+      ),
+    ]);
+    expect(hint).toBe('An unsought, unintended discovery');
+  });
+
+  it('splits block elements into lines when there is no list', async () => {
+    const hint = await hintFromDictionary('luck', 'en', [
+      htmlProvider('<div>luck</div><div>n. good fortune</div>'),
+    ]);
+    expect(hint).toBe('good fortune');
+  });
+
+  it('returns an empty string when no dictionary has it', async () => {
+    expect(await hintFromDictionary('luck', 'en', [provider('a', null)])).toBe('');
+  });
+});
diff --git a/apps/readest-app/src/__tests__/services/vocabulary/sentence.test.ts b/apps/readest-app/src/__tests__/services/vocabulary/sentence.test.ts
new file mode 100644
--- /dev/null
+++ b/apps/readest-app/src/__tests__/services/vocabulary/sentence.test.ts
@@ -0,0 +1,65 @@
+import { describe, expect, it } from 'vitest';
+import { sentenceAt } from '@/services/vocabulary/sentence';
+
+// The sentence saved with a lookup comes from the selection's own block, with
+// the spacing around the word kept (found in real use: the shared context
+// helper trims each side and reaches into the previous block).
+
+const rangeOver = (doc: Document, word: string) => {
+  const walker = doc.createTreeWalker(doc.body, NodeFilter.SHOW_TEXT);
+  for (let n = walker.nextNode(); n; n = walker.nextNode()) {
+    const at = n.textContent!.indexOf(word);
+    if (at >= 0) {
+      const range = doc.createRange();
+      range.setStart(n, at);
+      range.setEnd(n, at + word.length);
+      return range;
+    }
+  }
+  throw new Error(`no ${word}`);
+};
+
+const docOf = (html: string) => {
+  const doc = document.implementation.createHTMLDocument('t');
+  doc.body.innerHTML = html;
+  return doc;
+};
+
+describe('sentenceAt', () => {
+  it('keeps the spaces around the word and stays inside its paragraph', () => {
+    const doc = docOf(
+      '<h1>Chapter One</h1><p>It was pure serendipity that we met in Lisbon. Captain Nemo smiled.</p>',
+    );
+    expect(sentenceAt(rangeOver(doc, 'serendipity'))).toBe(
+      'It was pure serendipity that we met in Lisbon.',
+    );
+  });
+
+  it('reads across inline markup', () => {
+    const doc = docOf('<p>He said <em>nothing</em> at all. Then <b>Nemo</b> left.</p>');
+    expect(sentenceAt(rangeOver(doc, 'Nemo'))).toBe('Then Nemo left.');
+  });
+
+  it('leaves out ruby annotations such as Word Lens hints and furigana', () => {
+    const doc = docOf(
+      '<p>Captain Nemo smiled at the note <ruby class="wl-gloss">and<rt>和</rt></ruby> said nothing.</p>',
+    );
+    expect(sentenceAt(rangeOver(doc, 'Nemo'))).toBe(
+      'Captain Nemo smiled at the note and said nothing.',
+    );
+  });
+
+  it('returns an empty string instead of throwing on a range it cannot read', () => {
+    const doc = docOf('<p>Captain Nemo smiled.</p>');
+    const range = rangeOver(doc, 'Nemo');
+    range.cloneContents = () => {
+      throw new Error('detached');
+    };
+    expect(sentenceAt(range)).toBe('');
+  });
+
+  it('works for text without spaces', () => {
+    const doc = docOf('<p>他走了。我们必须斟酌这件事！然后呢</p>');
+    expect(sentenceAt(rangeOver(doc, '斟酌'))).toBe('我们必须斟酌这件事！');
+  });
+});
diff --git a/apps/readest-app/src/__tests__/services/vocabulary/vocabularySync.test.ts b/apps/readest-app/src/__tests__/services/vocabulary/vocabularySync.test.ts
new file mode 100644
--- /dev/null
+++ b/apps/readest-app/src/__tests__/services/vocabulary/vocabularySync.test.ts
@@ -0,0 +1,231 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import {
+  pullVocabulary,
+  pushVocabulary,
+  syncVocabulary,
+  type VocabularyCursor,
+  type VocabularySyncDeps,
+} from '@/services/vocabulary/vocabularySync';
+import { useVocabularyStore } from '@/store/vocabularyStore';
+import { useSettingsStore } from '@/store/settingsStore';
+import type { VocabularyRow } from '@/services/vocabulary/wire';
+import type { SystemSettings } from '@/types/settings';
+import type { AppService } from '@/types/system';
+
+const row = (
+  key: string,
+  updatedAt: string,
+  patch: Partial<VocabularyRow> = {},
+): VocabularyRow => ({
+  id: `en:${key}`,
+  lang: 'en',
+  word_key: key,
+  word: key,
+  state: 'learning',
+  hint: null,
+  occurrences: [],
+  created_at: 1,
+  modified_at: 1,
+  deleted_at: null,
+  updated_at: updatedAt,
+  ...patch,
+});
+
+const makeDeps = (patch: Partial<VocabularySyncDeps> = {}) => {
+  let cursor: VocabularyCursor | null = null;
+  const deps: VocabularySyncDeps = {
+    userId: 'u1',
+    pageSize: 2,
+    pull: vi.fn(async () => []),
+    push: vi.fn(async (rows: VocabularyRow[]) => ({
+      rows: rows.map((r) => ({ ...r, updated_at: 't' })),
+      rejected: [],
+    })),
+    getCursor: () => cursor,
+    setCursor: (c) => {
+      cursor = c;
+    },
+    ...patch,
+  };
+  return deps;
+};
+
+beforeEach(() => {
+  useVocabularyStore.setState({ entries: {}, loaded: true, loadedCount: 1, version: 0 });
+});
+afterEach(() => {
+  vi.useRealTimers();
+});
+
+describe('pullVocabulary', () => {
+  it('pages until a short page, applies rows and keeps the last row as the cursor', async () => {
+    const pages = [
+      [row('a', '2026-11-03T00:00:01.000Z'), row('b', '2026-11-03T00:00:02.000Z')],
+      [row('c', '2026-11-03T00:00:02.000Z')],
+    ];
+    const deps = makeDeps({ pull: vi.fn(async () => pages.shift() ?? []) });
+    await pullVocabulary(deps);
+
+    expect(deps.pull).toHaveBeenNthCalledWith(1, null, 2);
+    expect(deps.pull).toHaveBeenNthCalledWith(2, { ts: '2026-11-03T00:00:02.000Z', id: 'en:b' }, 2);
+    expect(deps.pull).toHaveBeenCalledTimes(2);
+    expect(Object.keys(useVocabularyStore.getState().entries).sort()).toEqual([
+      'en:a',
+      'en:b',
+      'en:c',
+    ]);
+    expect(deps.getCursor()).toEqual({ userId: 'u1', ts: '2026-11-03T00:00:02.000Z', id: 'en:c' });
+  });
+
+  it('writes the pulled words to the data file before moving the cursor', async () => {
+    const files: Record<string, string> = {};
+    const appService = {
+      exists: vi.fn(async () => false),
+      writeFile: vi.fn(async (path: string, _base: string, content: string) => {
+        files[path] = content;
+      }),
+    } as unknown as AppService;
+    await useVocabularyStore.getState().load(appService);
+    const onDisk: string[][] = [];
+    const deps = makeDeps({
+      pull: vi.fn(async () => [row('a', '2026-11-03T00:00:01.000Z')]),
+      setCursor: () => {
+        const saved = files['vocabulary.json'];
+        onDisk.push(saved ? JSON.parse(saved).entries.map((e: { id: string }) => e.id) : []);
+      },
+    });
+    await pullVocabulary(deps);
+    expect(onDisk).toEqual([['en:a']]);
+  });
+
+  it('re-reads the last minute before the saved cursor, for writes committed late', async () => {
+    const deps = makeDeps();
+    deps.setCursor({ userId: 'u1', ts: '2026-11-03T00:10:00.000Z', id: 'en:z' });
+    await pullVocabulary(deps);
+    expect(deps.pull).toHaveBeenCalledWith({ ts: '2026-11-03T00:09:00.000Z', id: '' }, 2);
+    // Nothing new: the saved cursor stays, even against an older row in the overlap.
+    const overlap = makeDeps({
+      pull: vi.fn(async () => [row('y', '2026-11-03T00:09:30.000+00:00')]),
+    });
+    overlap.setCursor({ userId: 'u1', ts: '2026-11-03T00:10:00.000Z', id: 'en:z' });
+    await pullVocabulary(overlap);
+    expect(overlap.getCursor()!.ts).toBe('2026-11-03T00:10:00.000Z');
+    expect(deps.getCursor()).toEqual({ userId: 'u1', ts: '2026-11-03T00:10:00.000Z', id: 'en:z' });
+  });
+
+  it('pulls from the start when the local file had no words (lost or unreadable)', async () => {
+    useVocabularyStore.setState({ loadedCount: 0 });
+    const deps = makeDeps();
+    deps.setCursor({ userId: 'u1', ts: '2026-11-03T00:10:00.000Z', id: 'en:z' });
+    await pullVocabulary(deps);
+    expect(deps.pull).toHaveBeenCalledWith(null, 2);
+  });
+
+  it('trusts the cursor again once a full pull has filled the list', async () => {
+    useVocabularyStore.setState({ loadedCount: 0 });
+    const deps = makeDeps({ pull: vi.fn(async () => [row('a', '2026-11-03T00:00:01.000Z')]) });
+    await pullVocabulary(deps);
+    vi.mocked(deps.pull).mockResolvedValue([]);
+    await pullVocabulary(deps);
+    // Back to the saved cursor (less the one-minute overlap), not from the start.
+    expect(deps.pull).toHaveBeenLastCalledWith({ ts: '2026-11-02T23:59:01.000Z', id: '' }, 2);
+  });
+
+  it("ignores another account's cursor", async () => {
+    const deps = makeDeps();
+    deps.setCursor({ userId: 'someone-else', ts: '2026-11-03T00:10:00.000Z', id: 'en:z' });
+    await pullVocabulary(deps);
+    expect(deps.pull).toHaveBeenCalledWith(null, 2);
+  });
+});
+
+describe('pushVocabulary', () => {
+  it('sends only dirty entries, in chunks, and clears dirty after', async () => {
+    const s = useVocabularyStore.getState();
+    for (const w of ['a', 'b', 'c']) s.ensureEntry(w, 'en');
+    useVocabularyStore.setState((st) => ({
+      entries: {
+        ...st.entries,
+        'en:d': { ...st.entries['en:a']!, id: 'en:d', key: 'd', dirty: false },
+      },
+    }));
+    const deps = makeDeps({ pushChunk: 2 });
+    await pushVocabulary(deps);
+
+    const pushed = vi.mocked(deps.push).mock.calls.map((c) => c[0].map((r) => r.id));
+    expect(pushed).toEqual([['en:a', 'en:b'], ['en:c']]);
+    expect(Object.values(useVocabularyStore.getState().entries).some((e) => e.dirty)).toBe(false);
+  });
+
+  it('keeps an entry dirty when it changes while its push is in flight', async () => {
+    const s = useVocabularyStore.getState();
+    vi.useFakeTimers();
+    vi.setSystemTime(1000);
+    const id = s.ensureEntry('run', 'en');
+    const deps = makeDeps({
+      push: vi.fn(async (rows: VocabularyRow[]) => {
+        vi.setSystemTime(2000);
+        useVocabularyStore.getState().setState(id, 'mastered');
+        return { rows, rejected: [] };
+      }),
+    });
+    await pushVocabulary(deps);
+    const e = useVocabularyStore.getState().entries[id]!;
+    expect(e.state).toBe('mastered');
+    expect(e.dirty).toBe(true);
+  });
+});
+
+describe('syncVocabulary', () => {
+  it('runs once more when a sync is asked for while one is running', async () => {
+    useSettingsStore.setState({ settings: { syncCategories: {} } as unknown as SystemSettings });
+    let release!: () => void;
+    const gate = new Promise<void>((r) => {
+      release = r;
+    });
+    const deps = makeDeps({
+      pull: vi.fn(async () => {
+        await gate;
+        return [];
+      }),
+    });
+    const first = syncVocabulary(async () => deps);
+    // A change made mid-sync: the debounced sync arrives while the first runs.
+    useVocabularyStore.getState().ensureEntry('late', 'en');
+    const second = syncVocabulary(async () => deps);
+    release();
+    await Promise.all([first, second]);
+    expect(deps.pull).toHaveBeenCalledTimes(2);
+    const pushed = vi.mocked(deps.push).mock.calls.flatMap(([rows]) => rows.map((r) => r.id));
+    expect(pushed).toContain('en:late');
+  });
+
+  it('still pulls when the push fails', async () => {
+    useSettingsStore.setState({ settings: { syncCategories: {} } as unknown as SystemSettings });
+    useVocabularyStore.getState().ensureEntry('run', 'en');
+    const deps = makeDeps({ push: vi.fn(async () => Promise.reject(new Error('500'))) });
+    await syncVocabulary(async () => deps);
+    expect(deps.pull).toHaveBeenCalled();
+  });
+
+  it('clears dirty on rows the server rejected so they stop blocking pushes', async () => {
+    const s = useVocabularyStore.getState();
+    s.ensureEntry('run', 'en');
+    const deps = makeDeps({
+      push: vi.fn(async () => ({ rows: [], rejected: ['en:run'] })),
+    });
+    await pushVocabulary(deps);
+    expect(useVocabularyStore.getState().entries['en:run']!.dirty).toBeFalsy();
+  });
+
+  it('does nothing when the Vocabulary sync category is off', async () => {
+    useSettingsStore.setState({
+      settings: { syncCategories: { vocabulary: false } } as unknown as SystemSettings,
+    });
+    const deps = makeDeps();
+    useVocabularyStore.getState().ensureEntry('run', 'en');
+    await syncVocabulary(async () => deps);
+    expect(deps.pull).not.toHaveBeenCalled();
