+fn request(
+    client: &reqwest::Client,
+    url: &str,
+    body: Option<&String>,
+    headers: &HashMap<String, String>,
+) -> reqwest::RequestBuilder {
+    let mut request = match body {
+        Some(body) => client.post(url).body(body.clone()),
+        None => client.get(url),
+    };
+    for (key, value) in headers {
+        request = request.header(key, value);
+    }
