--- /dev/null
+++ b/apps/readest-app/src/__tests__/document/fixed-layout-scroll-mode-mid-turn.browser.test.ts
@@ -0,0 +1,82 @@
+import { afterEach, describe, expect, it } from 'vitest';
+
+// Registers the <foliate-fxl> custom element (the fixed-layout / PDF renderer).
+import 'foliate-js/fixed-layout.js';
+
+// Switching to scrolled mode while a paginated page turn is still loading its
+// page (Shift+J as a PDF opens) left the view blank about one time in four: the
+// turn finished after the scrolled strip was built and hid every other child of
+// the renderer, the strip included. The strip must stay the view.
+
+const PAGE_HTML = `<!doctype html><html><head><style>
+  html, body { margin: 0; height: 1000px; }
+</style></head><body></body></html>`;
+
+const page = { src: 'srcdoc', data: PAGE_HTML };
+
+type Renderer = HTMLElement & {
+  open(book: unknown): void;
+  goToSpread(index: number, side: string, reason?: string): Promise<void>;
+};
+
+let renderer: Renderer | null = null;
+
+afterEach(() => {
+  renderer?.remove();
+  renderer = null;
+});
+
+const mount = (load: () => Promise<typeof page>) => {
+  renderer = document.createElement('foliate-fxl') as Renderer;
+  renderer.style.width = '600px';
+  renderer.style.height = '400px';
+  renderer.setAttribute('flow', 'paginated');
+  document.body.append(renderer);
+  renderer.open({
+    dir: 'ltr',
+    rendition: { viewport: { width: 600, height: 1000 }, spread: 'none' },
+    sections: Array.from({ length: 6 }, () => ({ load, linear: 'yes' })),
+  });
+  return renderer;
+};
+
+const expectStripShown = (r: Renderer) => {
+  const strip = r.shadowRoot!.querySelector<HTMLElement>('.scroll-container')!;
+  expect(getComputedStyle(strip).visibility).toBe('visible');
+  // Six 1000px pages at 600px wide: the strip scrolls well past the view.
+  expect(r.scrollHeight).toBeGreaterThan(r.clientHeight * 2);
+};
+
+describe('fixed-layout scroll mode entered during a page turn', () => {
+  it('keeps the strip when the switch comes while the page loads', async () => {
+    let release!: () => void;
+    const gate = new Promise<void>((resolve) => (release = resolve));
+    const r = mount(async () => {
+      await gate;
+      return page;
+    });
+
+    const turn = r.goToSpread(0, 'center', 'page');
+    r.setAttribute('flow', 'scrolled');
+    release();
+    await turn;
+
+    expectStripShown(r);
+  });
+
+  it('keeps the strip when the switch comes while the page frame loads', async () => {
+    const r = mount(async () => page);
+    // The turn appends the page's frame, then awaits its iframe load. An
+    // observer callback is a microtask, so it runs before that load event.
+    const observer = new MutationObserver(() => {
+      observer.disconnect();
+      r.setAttribute('flow', 'scrolled');
+    });
+    observer.observe(r.shadowRoot!, { childList: true });
+
+    await r.goToSpread(0, 'center', 'page');
+
+    expect(r.getAttribute('flow')).toBe('scrolled');
+    expectStripShown(r);
+  });
+});
diff --git a/apps/readest-app/src/__tests__/document/fixed-layout-select-superseded.browser.test.ts b/apps/readest-app/src/__tests__/document/fixed-layout-select-superseded.browser.test.ts
new file mode 100644
--- /dev/null
+++ b/apps/readest-app/src/__tests__/document/fixed-layout-select-superseded.browser.test.ts
@@ -0,0 +1,120 @@
+import { afterEach, describe, expect, it } from 'vitest';
+
+// Registers the <foliate-fxl> custom element (the fixed-layout / PDF renderer).
+import 'foliate-js/fixed-layout.js';
+
+// view.select() in scrolled mode waits for the target page to load. Going
+// somewhere else meanwhile (a page jump, a page turn) supersedes it: when the
+// page loads later, the old select must not select its match, pull the view
+// back to it, or report a 'selection' relocation.
+
+const PAGE_HTML = `<!doctype html><html><head><style>
+  html, body { margin: 0; height: 1000px; }
+  p { margin: 600px 0 0; }
+</style></head><body><p>match</p></body></html>`;
+
+const waitFor = async (condition: () => boolean, timeout = 4000): Promise<void> => {
+  const start = performance.now();
+  while (!condition()) {
+    if (performance.now() - start > timeout) throw new Error('waitFor timed out');
+    await new Promise((resolve) => setTimeout(resolve, 30));
+  }
+};
+
+type Target = { index: number; anchor?: (doc: Document) => Range; select?: boolean };
+
+type Renderer = HTMLElement & {
+  open(book: unknown): void;
+  destroy(): void;
+  goTo(target: Target): Promise<void>;
+  prev(distance?: number): Promise<void>;
+  getContents(): { doc: Document; index: number }[];
+};
+
+let renderer: Renderer | null = null;
+
+afterEach(() => {
+  renderer?.destroy();
+  renderer?.remove();
+  renderer = null;
+});
+
+const TARGET = 4;
+
+// Six 1000px pages in a 600x400 scrolled view; page TARGET loads only once
+// released.
+const mount = () => {
+  let release!: () => void;
+  const gate = new Promise<void>((resolve) => (release = resolve));
+  let started = false;
+  const page = { src: 'srcdoc', data: PAGE_HTML };
+  const r = document.createElement('foliate-fxl') as Renderer;
+  r.style.width = '600px';
+  r.style.height = '400px';
+  r.setAttribute('flow', 'scrolled');
+  const selections: unknown[] = [];
+  r.addEventListener('relocate', (e) => {
+    const { detail } = e as CustomEvent;
+    if (detail.reason === 'selection') selections.push(detail);
+  });
+  document.body.append(r);
+  r.open({
+    dir: 'ltr',
+    rendition: { viewport: { width: 600, height: 1000 }, spread: 'none' },
+    sections: Array.from({ length: 6 }, (_, i) => ({
+      linear: 'yes',
+      load: async () => {
+        if (i === TARGET) {
+          started = true;
+          await gate;
+        }
+        return page;
+      },
+    })),
+  });
+  renderer = r;
+  return { r, release, started: () => started, selections };
+};
+
+const anchor = (doc: Document) => {
+  const range = doc.createRange();
+  range.selectNodeContents(doc.querySelector('p')!);
+  return range;
+};
+
+const targetSelection = (r: Renderer) =>
+  r
+    .getContents()
+    .find((c) => c.index === TARGET)
+    ?.doc.getSelection()
+    ?.toString() ?? '';
+
+describe('fixed-layout view.select() superseded while its page loads', () => {
+  it('is dropped when a page jump comes first', async () => {
+    const { r, release, started, selections } = mount();
+
+    const select = r.goTo({ index: TARGET, anchor, select: true });
+    await waitFor(started);
+    await r.goTo({ index: TARGET - 1 });
+    const scrollTop = r.scrollTop;
+    release();
+    await select;
+
+    expect(selections).toEqual([]);
+    expect(targetSelection(r)).toBe('');
+    expect(r.scrollTop).toBe(scrollTop);
+  });
+
+  it('is dropped when a page turn comes first', async () => {
+    const { r, release, started, selections } = mount();
+
+    const select = r.goTo({ index: TARGET, anchor, select: true });
+    await waitFor(started);
+    await r.prev();
+    release();
+    await select;
+
+    expect(selections).toEqual([]);
+    expect(targetSelection(r)).toBe('');
+  });
+});
diff --git a/apps/readest-app/src/__tests__/document/fixed-layout-spread-pinch.browser.test.ts b/apps/readest-app/src/__tests__/document/fixed-layout-spread-pinch.browser.test.ts
new file mode 100644
--- /dev/null
+++ b/apps/readest-app/src/__tests__/document/fixed-layout-spread-pinch.browser.test.ts
@@ -0,0 +1,132 @@
+import { afterEach, describe, expect, it } from 'vitest';
+
+// Registers the <foliate-fxl> custom element (the fixed-layout / PDF renderer).
+import 'foliate-js/fixed-layout.js';
+
+// A paginated pinch previews the zoom with a CSS scale on the shown pages, then
+// the release commits it as a re-layout and scrolls back to where the preview
+// showed the pages. On a two-page spread each page was scaled around its own
+// centre, so the pages grew apart and the committed spread landed sideways
+// from the preview (readest#6941).
+
+const PAGE_HTML = `<!doctype html><html><head><style>
+  html, body { margin: 0; height: 100%; background: #eee; }
+</style></head><body></body></html>`;
+
+const makeBook = () => ({
+  dir: 'ltr',
+  rendition: { viewport: { width: 600, height: 800 }, spread: 'auto' },
+  // Section 0 is the cover on its own; sections 1 and 2 share spread 1.
+  sections: Array.from({ length: 3 }, () => ({
+    load: async () => ({ src: 'srcdoc', data: PAGE_HTML }),
+    linear: 'yes',
+  })),
+});
+
+type Renderer = HTMLElement & {
+  open(book: unknown): void;
+  goToSpread(index: number, side: string): Promise<void>;
+  pinchZoom(ratio: number): void;
+  pinchEnd(): void;
+};
+
+const waitFor = async <T>(fn: () => T | null | undefined, timeout = 4000): Promise<T> => {
+  const start = performance.now();
+  for (;;) {
+    const value = fn();
+    if (value) return value;
+    if (performance.now() - start > timeout) throw new Error('waitFor timed out');
+    await new Promise((r) => setTimeout(r, 30));
+  }
+};
+
+let renderer: Renderer | null = null;
+
+afterEach(() => {
+  renderer?.remove();
+  renderer = null;
+});
+
+const mount = async (width: number, height: number, side: string) => {
+  renderer = document.createElement('foliate-fxl') as Renderer;
+  Object.assign(renderer.style, { width: `${width}px`, height: `${height}px` });
+  document.body.append(renderer);
+  renderer.open(makeBook());
+  await renderer.goToSpread(1, side);
+  await waitFor(() => shownPages().length);
+  await new Promise((r) => setTimeout(r, 100));
+  return renderer;
+};
+
+// The page boxes on screen, left to right.
+const shownPages = () =>
+  [...renderer!.shadowRoot!.querySelectorAll('iframe')]
+    .map((iframe) => iframe.parentElement!)
+    .filter((el) => el.offsetWidth > 0 && getComputedStyle(el).visibility !== 'hidden')
+    .sort((a, b) => a.offsetLeft - b.offsetLeft);
+
+type Rect = { left: number; top: number; width: number; height: number };
+
+const rects = (): Rect[] =>
+  shownPages().map((el) => {
+    const { left, top, width, height } = el.getBoundingClientRect();
+    return { left, top, width, height };
+  });
+
+// Previews `ratio` on the shown pages, then releases and commits the zoom.
+const pinch = (host: Renderer, ratio: number) => {
+  const baseline = rects();
+  host.pinchZoom(ratio);
+  const preview = rects();
+  host.pinchEnd();
+  host.setAttribute('scale-factor', String(ratio * 100));
+  const committed = rects();
+  // The pinch has to have zoomed, or matching rects prove nothing.
+  baseline.forEach((rect, i) => {
+    expect(committed[i]!.width).toBeCloseTo(rect.width * ratio, 0);
+  });
+  return { preview, committed };
+};
+
+const expectSameRects = (actual: Rect[], expected: Rect[]) => {
+  expect(actual).toHaveLength(expected.length);
+  actual.forEach((rect, i) => {
+    for (const key of ['left', 'top', 'width', 'height'] as const) {
+      // The spine overlap shifts the right page by a pixel at most.
+      expect(Math.abs(rect[key] - expected[i]![key]), `page ${i} ${key}`).toBeLessThanOrEqual(1);
+    }
+  });
+};
+
+describe('fixed-layout paginated pinch', () => {
+  it('commits a two-page spread where the preview showed it', async () => {
+    const host = await mount(1000, 600, 'left');
+    expect(shownPages()).toHaveLength(2);
+
+    const { preview, committed } = pinch(host, 2);
+    expectSameRects(committed, preview);
+  });
+
+  // Portrait shows one page of the spread. When it's the right one, the left
+  // page is display: none and has no rect to anchor on.
+  it('commits the right page of a portrait spread where the preview showed it', async () => {
+    const host = await mount(600, 1000, 'right');
+    expect(shownPages()).toHaveLength(1);
+
+    const { preview, committed } = pinch(host, 2);
+    expectSameRects(committed, preview);
+  });
+
+  // The cover sits on the right with a blank slot facing it.
+  it('commits the cover spread where the preview showed it', async () => {
+    const host = await mount(1000, 600, 'left');
+    await host.goToSpread(0, 'right');
+    await new Promise((r) => setTimeout(r, 100));
+    // The blank slot keeps its box, so both are laid out; its iframe is hidden.
+    expect(shownPages()).toHaveLength(2);
+    expect(shownPages()[0]!.querySelector('iframe')!.style.display).toBe('none');
+
+    const { preview, committed } = pinch(host, 2);
+    expectSameRects(committed, preview);
+  });
+});
