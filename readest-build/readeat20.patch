@@ -0,0 +1,27 @@
+import type { AppService } from '@/types/system';
+import type { VocabularyEntry } from './types';
+
+/** Lives in the Data dir next to statistics.db; tombstones included. */
+export const VOCABULARY_FILENAME = 'vocabulary.json';
+
+interface VocabularyFile {
+  version: 1;
+  entries: VocabularyEntry[];
+}
+
+export const parseVocabularyFile = (text: string): VocabularyEntry[] => {
+  const data = JSON.parse(text) as Partial<VocabularyFile>;
+  return Array.isArray(data.entries) ? data.entries : [];
+};
+
+export const serializeVocabulary = (entries: VocabularyEntry[]): string =>
+  JSON.stringify({ version: 1, entries } satisfies VocabularyFile);
+
+export const readVocabularyFile = async (appService: AppService): Promise<VocabularyEntry[]> => {
+  if (!(await appService.exists(VOCABULARY_FILENAME, 'Data'))) return [];
+  const text = await appService.readFile(VOCABULARY_FILENAME, 'Data', 'text');
+  return parseVocabularyFile(text as string);
+};
+
+export const writeVocabularyFile = (appService: AppService, entries: VocabularyEntry[]) =>
+  appService.writeFile(VOCABULARY_FILENAME, 'Data', serializeVocabulary(entries));
diff --git a/apps/readest-app/src/services/vocabulary/sentence.ts b/apps/readest-app/src/services/vocabulary/sentence.ts
new file mode 100644
--- /dev/null
+++ b/apps/readest-app/src/services/vocabulary/sentence.ts
@@ -0,0 +1,42 @@
+import { extractSentence } from './entry';
+
+const BLOCK_SELECTOR =
+  'p, li, blockquote, dd, dt, td, th, h1, h2, h3, h4, h5, h6, pre, figcaption, div';
+
+const blockOf = (node: Node): Element | null => {
+  const element = node.nodeType === Node.ELEMENT_NODE ? (node as Element) : node.parentElement;
+  return element?.closest(BLOCK_SELECTOR) ?? element;
+};
+
+// A range's text without ruby annotations (Word Lens hints, furigana).
+const textOf = (range: Range): string => {
+  const fragment = range.cloneContents();
+  fragment.querySelectorAll('rt, rp').forEach((el) => el.remove());
+  return fragment.textContent ?? '';
+};
+
+/**
+ * The sentence a selection sits in, read from its own block only and with the
+ * text on either side left untrimmed, so the spaces around the word survive.
+ */
+export const sentenceAt = (range: Range): string => {
+  // Runs while rendering the dictionary popup; a range it can't read (e.g. a
+  // section remounting under it) gives '' and the caller falls back.
+  try {
+    const doc = range.startContainer.ownerDocument!;
+    const head = doc.createRange();
+    const first = blockOf(range.startContainer);
+    if (first) head.setStart(first, 0);
+    else head.collapse(true);
+    head.setEnd(range.startContainer, range.startOffset);
+    const tail = doc.createRange();
+    tail.setStart(range.endContainer, range.endOffset);
+    const last = blockOf(range.endContainer);
+    if (last) tail.setEnd(last, last.childNodes.length);
+    else tail.collapse(true);
+    return extractSentence(textOf(head), textOf(range), textOf(tail));
+  } catch (err) {
+    console.warn('[vocabulary] could not read the sentence', err);
+    return '';
+  }
+};
diff --git a/apps/readest-app/src/services/vocabulary/types.ts b/apps/readest-app/src/services/vocabulary/types.ts
new file mode 100644
--- /dev/null
+++ b/apps/readest-app/src/services/vocabulary/types.ts
@@ -0,0 +1,50 @@
+// Vocabulary builder (#789) and the per-word Word Lens marks (#6613).
+// See docs/superpowers/specs/2026-11-03-vocabulary-builder-design.md
+
+/**
+ * `none`: only looked up, Word Lens decides from its pack.
+ * `learning`: always hinted. `mastered`: never hinted.
+ */
+export type VocabularyState = 'none' | 'learning' | 'mastered';
+
+/** One sentence a word was looked up in. */
+export interface VocabularyOccurrence {
+  sentence: string;
+  bookHash?: string;
+  bookTitle?: string;
+  bookAuthor?: string;
+  cfi?: string;
+  /** Epoch ms of the lookup. */
+  at: number;
+}
+
+export interface VocabularyEntry {
+  /** `${lang}:${key}`, the same on every device. */
+  id: string;
+  /** Book source language as a base code (`en`), or `und` when unknown. */
+  lang: string;
+  /** Normalized lowercase headword used for matching. */
+  key: string;
+  /** Display form as first captured. */
+  word: string;
+  state: VocabularyState;
+  /** Word Lens hint saved by the reader; the pack's gloss is used when unset. */
+  hint?: string;
+  /** Newest first, at most MAX_OCCURRENCES. */
+  occurrences: VocabularyOccurrence[];
+  createdAt: number;
