+const show = (locked = false) => {
+  const onFieldChange = vi.fn();
+  render(
+    <BookDetailEdit
+      book={{ title: 'Book', author: 'Author' } as Book}
+      metadata={{ title: 'Book', author: 'Author', language: 'en' }}
+      tags={[]}
+      fieldSources={{}}
+      lockedFields={{ coverImageUrl: locked }}
+      fieldErrors={{}}
+      searchLoading={false}
+      onFieldChange={onFieldChange}
