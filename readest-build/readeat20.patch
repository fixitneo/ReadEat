+import { act, cleanup, fireEvent, render, screen } from '@testing-library/react';
+import { useState } from 'react';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import PersonalShelfHelp from '@/app/library/components/PersonalShelfHelp';
+import { useDeviceControlStore } from '@/store/deviceStore';
+import { eventDispatcher } from '@/utils/event';
+
+vi.mock('@/context/EnvContext', () => ({
+  useEnv: () => ({ appService: { isAndroidApp: true } }),
+}));
+vi.mock('@/utils/bridge', () => ({
+  interceptKeys: vi.fn().mockResolvedValue(undefined),
+  getScreenBrightness: vi.fn(),
+  setScreenBrightness: vi.fn(),
+}));
+
+afterEach(() => {
+  cleanup();
+  expect(useDeviceControlStore.getState().backKeyInterceptionCount).toBe(0);
+});
+
+function Guide() {
+  const [open, setOpen] = useState(true);
+  return <PersonalShelfHelp open={open} onClose={() => setOpen(false)} />;
+}
+
+describe('personal help navigation', () => {
+  for (const key of ['native', 'escape']) {
+    it(`returns from image to detail, list and bookshelf with ${key} Back`, () => {
+      render(<Guide />);
+      expect(useDeviceControlStore.getState().backKeyIntercepted).toBe(true);
+      const topic = document.querySelector<HTMLButtonElement>('.readit-help-topic')!;
+      fireEvent.click(topic);
+      const detail = document.querySelector('[data-help-scenario]');
+      expect(detail).toBeTruthy();
+      fireEvent.click(screen.getAllByRole('button', { name: /예시 화면 확대/ })[0]!);
+      expect(screen.getByRole('dialog', { name: '예시 화면 확대' })).toBeTruthy();
+      const back = () =>
+        act(() => {
+          if (key === 'native') {
+            expect(
+              eventDispatcher.dispatchSync('native-key-down', { keyName: 'Back', keyCode: 4 }),
+            ).toBe(true);
+          } else {
+            fireEvent.keyDown(window, { key: 'Escape' });
+          }
+        });
+      back();
+      expect(screen.queryByRole('dialog', { name: '예시 화면 확대' })).toBeNull();
+      expect(document.querySelector('[data-help-scenario]')).toBeTruthy();
+      back();
+      expect(document.querySelector('[data-help-scenario]')).toBeNull();
+      expect(screen.getByRole('dialog', { name: 'ReadEat 사용 안내' })).toBeTruthy();
+      back();
+      expect(screen.queryByRole('dialog', { name: 'ReadEat 사용 안내' })).toBeNull();
+      expect(useDeviceControlStore.getState().backKeyIntercepted).toBe(false);
+    });
+  }
+});
