+            tauri::async_runtime::spawn_blocking(move || {
+                reply
+                    .recv()
+                    .map_err(|error| crate::Error::NativeTTSError(error.to_string()))?
+                    .map_err(crate::Error::NativeTTSError)
+            })
+            .await
+            .map_err(|error| crate::Error::NativeTTSError(error.to_string()))?
+            .map_err(Into::into)
+        }),
