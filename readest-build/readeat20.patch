--- /dev/null
+++ b/apps/readest-app/src/services/vocabulary/entry.ts
@@ -0,0 +1,112 @@
+import type { VocabularyEntry, VocabularyOccurrence } from './types';
+
+export const MAX_OCCURRENCES = 20;
+
+// Anything that isn't a letter, mark or number at either end: quotes,
+// brackets, commas, CJK punctuation.
+const EDGE_PUNCT = /^[^\p{L}\p{M}\p{N}]+|[^\p{L}\p{M}\p{N}]+$/gu;
+
+export const normalizeWordKey = (word: string): string =>
+  word.replace(/[’‘]/g, "'").replace(EDGE_PUNCT, '').toLowerCase();
+
+export const entryId = (lang: string, key: string): string => `${lang}:${key}`;
+
+/** Base language code a book tag files its words under (`en-US` → `en`), `und` if unknown. */
+export const vocabularyLang = (tag?: string | null): string =>
+  (typeof tag === 'string' && tag.toLowerCase().split('-')[0]) || 'und';
+
+const SENTENCE_END = /[.!?。！？…]/;
+
+export const MAX_SENTENCE_LEN = 300;
+
+const collapse = (s: string) => s.replace(/\s+/g, ' ');
+
+/**
+ * The sentence around `word`, given the text right before and after it. A very
+ * long sentence (or a block with no terminators) is cut to a window around the
+ * word so one lookup can't bloat its synced row.
+ */
+export const extractSentence = (before: string, word: string, after: string): string => {
+  let start = before.length;
+  while (start > 0 && !SENTENCE_END.test(before[start - 1]!)) start--;
+  let end = 0;
+  while (end < after.length && !SENTENCE_END.test(after[end]!)) end++;
+  // Keep the terminator (and any run of them, "?!").
+  while (end < after.length && SENTENCE_END.test(after[end]!)) end++;
+  let pre = collapse(before.slice(start)).trimStart();
+  let post = collapse(after.slice(0, end)).trimEnd();
+  const w = collapse(word);
+  if (w.length >= MAX_SENTENCE_LEN) return `${w.slice(0, MAX_SENTENCE_LEN).trimEnd()}…`;
+  const half = Math.max(0, Math.floor((MAX_SENTENCE_LEN - w.length) / 2));
+  // slice(-0) would keep everything: with no room left, drop the context.
+  if (pre.length > half) pre = half ? `…${pre.slice(-half).trimStart()}` : '';
+  if (post.length > half) post = half ? `${post.slice(0, half).trimEnd()}…` : '';
+  return `${pre}${w}${post}`.trim();
+};
+
+// The same sentence in the same book is one occurrence; its CFI can shift
+// (Word Lens hint markup), so it isn't part of the identity.
+const occurrenceKey = (o: VocabularyOccurrence) => `${o.bookHash ?? ''}|${o.sentence}`;
+
+const normalizeOccurrences = (list: VocabularyOccurrence[]): VocabularyOccurrence[] => {
+  const seen = new Set<string>();
+  return [...list]
+    .sort((a, b) => b.at - a.at)
+    .filter((o) => {
+      const k = occurrenceKey(o);
+      if (seen.has(k)) return false;
+      seen.add(k);
+      return true;
+    })
+    .slice(0, MAX_OCCURRENCES);
+};
+
+export const addOccurrence = (
+  entry: VocabularyEntry,
+  occurrence: VocabularyOccurrence,
+): VocabularyEntry => ({
+  ...entry,
+  occurrences: normalizeOccurrences([occurrence, ...entry.occurrences]),
+});
+
+// Newer edit wins. A tie (same ms on two devices) must pick the same side on
+// every device and on the server, whatever the argument order: a delete
+// first, then the larger state/hint, then the larger display word.
+const tieKey = (e: VocabularyEntry) =>
+  `${e.deletedAt ? 1 : 0}|${e.state}|${e.hint ?? ''}|${e.word}`;
+const aWins = (a: VocabularyEntry, b: VocabularyEntry) =>
+  a.modifiedAt !== b.modifiedAt ? a.modifiedAt > b.modifiedAt : tieKey(a) >= tieKey(b);
+
+/**
+ * Merge two copies of one entry. The side changed last wins the state, hint
+ * and tombstone; sentences are unioned. A delete drops every sentence from
+ * before it, so a word looked up again after a delete comes back with only
+ * the new sentences.
+ */
+export const mergeEntries = (a: VocabularyEntry, b: VocabularyEntry): VocabularyEntry => {
+  const [winner, loser] = aWins(a, b) ? [a, b] : [b, a];
+  const { dirty: _dirty, ...base } = winner;
+  if (winner.deletedAt) {
+    // Lookups don't move modifiedAt, so a device that missed the delete can
+    // hold sentences from after it: those bring the word back, unmarked.
+    const after = loser.occurrences.filter((o) => o.at > winner.deletedAt!);
+    if (!after.length) return { ...base, occurrences: [] };
+    const { hint: _hint, ...alive } = base;
+    return {
+      ...alive,
+      state: 'none',
+      deletedAt: null,
+      occurrences: normalizeOccurrences(after),
+    };
+  }
+  const deletedAt = loser.deletedAt ?? 0;
+  const occurrences = normalizeOccurrences(
+    [...winner.occurrences, ...loser.occurrences].filter((o) => o.at > deletedAt),
+  );
+  return {
+    ...base,
+    createdAt: Math.min(a.createdAt, b.createdAt),
+    deletedAt: null,
+    occurrences,
+  };
+};
diff --git a/apps/readest-app/src/services/vocabulary/export.ts b/apps/readest-app/src/services/vocabulary/export.ts
new file mode 100644
--- /dev/null
+++ b/apps/readest-app/src/services/vocabulary/export.ts
@@ -0,0 +1,102 @@
+import type { VocabularyEntry } from './types';
+
+// Vocabulary export (#789): an Anki text-import file (the header lines make it
+// import without field mapping) and a CSV for spreadsheets / other apps.
+
+const escapeHtml = (s: string) =>
+  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
+
+const oneLine = (s: string) => s.replace(/[\t\r\n]+/g, ' ');
+
+const escapeRegExp = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+
+// Scripts written without spaces have no word boundaries to respect.
+export const UNSPACED = /[\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}\p{Script=Thai}]/u;
+
+/** Bold `word` inside an already-escaped sentence. */
+const boldWord = (sentence: string, word: string): string => {
+  const w = escapeRegExp(escapeHtml(word));
+  if (UNSPACED.test(word)) return sentence.replace(new RegExp(w, 'giu'), (m) => `<b>${m}</b>`);
+  // No lookbehind (WebKit < 16.4 rejects it): consume the boundary before the word.
+  const re = new RegExp(`(^|[^\\p{L}\\p{M}\\p{N}])(${w})(?![\\p{L}\\p{M}\\p{N}])`, 'giu');
+  return sentence.replace(re, (_m, pre: string, hit: string) => `${pre}<b>${hit}</b>`);
+};
+
+const latest = (e: VocabularyEntry) => e.occurrences[0];
+
+const bookTag = (title?: string) => (title ? title.trim().replace(/\s+/g, '_') : '');
+
+/** The card a word becomes in Anki, for the file export and the AnkiDroid link. */
+export const ankiCardOf = (e: VocabularyEntry): { front: string; back: string; tags: string[] } => {
+  const occ = latest(e);
+  const word = escapeHtml(oneLine(e.word));
+  const sentence = occ ? boldWord(escapeHtml(oneLine(occ.sentence)), oneLine(e.word)) : '';
+  const front = `<div style="font-size:1.6em">${word}</div>${sentence ? `<div>${sentence}</div>` : ''}`;
+  const source = [occ?.bookTitle, occ?.bookAuthor].filter(Boolean).map((s) => oneLine(s!));
+  const back = [
+    escapeHtml(oneLine(e.hint ?? '')),
+    source.length ? `<small>${escapeHtml(source.join(' — '))}</small>` : '',
+  ]
+    .filter(Boolean)
+    .join('<br>');
+  const tags = ['readest', bookTag(occ?.bookTitle)].filter(Boolean);
+  return { front, back, tags };
+};
+
+export const toAnkiText = (entries: VocabularyEntry[]): string => {
+  const lines = [
+    '#separator:tab',
+    '#html:true',
+    '#notetype:Basic',
+    '#deck:Readest Vocabulary',
+    '#tags column:3',
+  ];
+  for (const e of entries) {
+    const { front, back, tags } = ankiCardOf(e);
+    lines.push([front, back, tags.join(' ')].join('\t'));
+  }
+  return `${lines.join('\n')}\n`;
+};
+
+const csvField = (v: string | number) => {
+  // Book text and hints are untrusted: keep spreadsheet apps from running a
+  // cell that starts like a formula.
+  const s = typeof v === 'string' && /^[=+\-@\t\r]/.test(v) ? `'${v}` : String(v);
+  return /[",\r\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
+};
+
+const day = (ms: number) => new Date(ms).toISOString().slice(0, 10);
+
+export const toCsv = (entries: VocabularyEntry[]): string => {
+  const rows = [
+    [
+      'word',
+      'state',
+      'hint',
+      'latest sentence',
+      'all sentences',
+      'book',
+      'author',
+      'first looked up',
+      'last looked up',
+      'lookup count',
+    ],
+  ];
+  for (const e of entries) {
+    const occ = latest(e);
+    const times = e.occurrences.map((o) => o.at);
+    rows.push([
+      e.word,
+      e.state,
+      e.hint ?? '',
+      occ?.sentence ?? '',
+      e.occurrences.map((o) => o.sentence).join('\n'),
+      occ?.bookTitle ?? '',
+      occ?.bookAuthor ?? '',
+      day(times.length ? Math.min(...times) : e.createdAt),
+      day(times.length ? Math.max(...times) : e.createdAt),
+      String(e.occurrences.length),
+    ]);
+  }
+  return `﻿${rows.map((r) => r.map(csvField).join(',')).join('\r\n')}\r\n`;
+};
