+
+const occurrence = (sentence: string, at: number) => ({ sentence, at, bookHash: 'b1' });
+const occurrenceEntry = (key: string) => ({
+  id: `en:${key}`,
+  lang: 'en',
+  key,
+  word: key,
+  state: 'none' as const,
+  occurrences: [occurrence('Saved.', 1)],
+  createdAt: 1,
+  modifiedAt: 0,
+  deletedAt: null,
