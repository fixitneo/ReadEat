+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+const { invokeSpy } = vi.hoisted(() => ({ invokeSpy: vi.fn() }));
+vi.mock('@tauri-apps/api/core', async (importOriginal) => ({
+  ...(await importOriginal<typeof import('@tauri-apps/api/core')>()),
+  invoke: invokeSpy,
+}));
+
+import {
+  AnkiError,
+  ankiAddNotes,
+  ankiReadDeck,
+  ankiStatus,
+  ankiUpdateTags,
+} from '@/services/vocabulary/ankiDroid';
+
+beforeEach(() => {
+  invokeSpy.mockReset();
+});
+
+describe('ankiDroid', () => {
+  it('reads a deck by id through the native bridge', async () => {
+    invokeSpy.mockResolvedValue({ notes: [{ id: 1, fields: ['a'], tags: '' }] });
+    const deck = await ankiReadDeck([5, 6], true);
+    expect(invokeSpy).toHaveBeenCalledWith('plugin:native-bridge|anki_read_deck', {
+      payload: { deckIds: [5, 6], withCards: true },
+    });
+    expect(deck).toEqual({ notes: [{ id: 1, fields: ['a'], tags: '' }], cards: undefined });
+  });
+
+  it('turns an error field into an AnkiError with its code', async () => {
+    invokeSpy.mockResolvedValue({ error: 'not_ready' });
+    const err = await ankiReadDeck([5], true).catch((e: unknown) => e);
+    expect(err).toBeInstanceOf(AnkiError);
+    expect((err as AnkiError).code).toBe('not_ready');
+  });
+
+  it('sends notes and returns how many were added', async () => {
+    invokeSpy.mockResolvedValue({ added: 2 });
+    const notes = [{ fields: ['f', 'b'] as [string, string], tags: ['readest'] }];
+    await expect(ankiAddNotes('Readest Vocabulary', notes)).resolves.toBe(2);
+    expect(invokeSpy).toHaveBeenCalledWith('plugin:native-bridge|anki_add_notes', {
+      payload: { deckName: 'Readest Vocabulary', notes },
+    });
+  });
+
+  it('updates note tags and returns how many changed', async () => {
+    invokeSpy.mockResolvedValue({ updated: 2 });
+    const notes = [
+      { id: 1, tags: ['readest', 'readest::mastered'] },
+      { id: 2, tags: ['readest::learning'] },
+    ];
+    await expect(ankiUpdateTags(notes)).resolves.toBe(2);
+    expect(invokeSpy).toHaveBeenCalledWith('plugin:native-bridge|anki_update_tags', {
+      payload: { notes },
+    });
+  });
+
+  it('reports AnkiDroid missing when the bridge is unavailable', async () => {
+    invokeSpy.mockRejectedValue(new Error('Unsupported platform for this plugin'));
+    await expect(ankiStatus()).resolves.toEqual({ installed: false, granted: false });
+  });
+});
diff --git a/apps/readest-app/src/__tests__/services/vocabulary/entry.test.ts b/apps/readest-app/src/__tests__/services/vocabulary/entry.test.ts
new file mode 100644
--- /dev/null
+++ b/apps/readest-app/src/__tests__/services/vocabulary/entry.test.ts
@@ -0,0 +1,200 @@
+import { describe, it, expect } from 'vitest';
+import {
+  MAX_OCCURRENCES,
+  MAX_SENTENCE_LEN,
+  addOccurrence,
+  entryId,
+  extractSentence,
+  mergeEntries,
+  normalizeWordKey,
+  vocabularyLang,
+} from '@/services/vocabulary/entry';
+import type { VocabularyEntry, VocabularyOccurrence } from '@/services/vocabulary/types';
+
+const occ = (sentence: string, at: number, extra: Partial<VocabularyOccurrence> = {}) => ({
+  sentence,
+  at,
+  bookHash: 'h1',
+  cfi: `epubcfi(/6/2!/4/${at})`,
+  ...extra,
+});
+
+const entry = (patch: Partial<VocabularyEntry> = {}): VocabularyEntry => ({
+  id: 'en:serendipity',
+  lang: 'en',
+  key: 'serendipity',
+  word: 'serendipity',
+  state: 'none',
+  occurrences: [],
+  createdAt: 1,
+  modifiedAt: 1,
+  deletedAt: null,
+  ...patch,
+});
+
+describe('normalizeWordKey', () => {
+  it('strips edge punctuation and lowercases', () => {
+    expect(normalizeWordKey('“Running,”')).toBe('running');
+    expect(normalizeWordKey('  Serendipity. ')).toBe('serendipity');
+  });
+  it('folds curly apostrophes to straight ones', () => {
+    expect(normalizeWordKey('Don’t')).toBe("don't");
+  });
+  it('keeps CJK text and inner hyphens', () => {
+    expect(normalizeWordKey('「斟酌」')).toBe('斟酌');
+    expect(normalizeWordKey('well-known')).toBe('well-known');
+  });
+});
+
+describe('entryId', () => {
+  it('joins language and key', () => {
+    expect(entryId('und', 'run')).toBe('und:run');
+  });
+});
+
+describe('extractSentence', () => {
+  it('caps the context when the selection leaves no room for it', () => {
+    const before = `Start. ${'a '.repeat(200)}`;
+    const after = ` ${'b '.repeat(200)}end.`;
+    for (const len of [MAX_SENTENCE_LEN - 1, MAX_SENTENCE_LEN - 2]) {
+      const s = extractSentence(before, 'x'.repeat(len), after);
+      expect(s.length).toBeLessThanOrEqual(MAX_SENTENCE_LEN + 2);
+    }
+  });
+
+  it('caps a selection longer than the limit', () => {
+    const long = 'word '.repeat(80).trim();
+    const s = extractSentence('Before. Some context ', long, ' after it. Next.');
+    expect(s.length).toBeLessThanOrEqual(MAX_SENTENCE_LEN + 2);
+    expect(s.startsWith('word word')).toBe(true);
+  });
+
+  it('cuts the surrounding text to the sentence holding the word', () => {
+    expect(extractSentence('He paused. It was pure ', 'serendipity', ' that we met. Then')).toBe(
+      'It was pure serendipity that we met.',
+    );
+  });
+  it('handles CJK terminators', () => {
+    expect(extractSentence('他走了。我们必须', '斟酌', '这件事！然后')).toBe(
+      '我们必须斟酌这件事！',
+    );
+  });
+  it('falls back to the word when there is no context', () => {
+    expect(extractSentence('', 'word', '')).toBe('word');
+  });
+  it('keeps a long sentence to a window around the word', () => {
+    const filler = 'word '.repeat(200);
+    const s = extractSentence(filler, 'serendipity', ` ${filler}.`);
+    expect(s.length).toBeLessThanOrEqual(MAX_SENTENCE_LEN + 2);
+    expect(s).toContain('serendipity');
+    expect(s.startsWith('…')).toBe(true);
+    expect(s.endsWith('…')).toBe(true);
+  });
+
+  it('collapses whitespace and newlines', () => {
+    expect(extractSentence('Line one.\n\nThe  ', 'cat', '\n sat.')).toBe('The cat sat.');
+  });
+});
+
+describe('addOccurrence', () => {
+  it('puts the newest first and ignores an identical occurrence', () => {
+    let e = addOccurrence(entry(), occ('A cat.', 1));
+    e = addOccurrence(e, occ('B cat.', 2));
+    e = addOccurrence(e, occ('B cat.', 3, { bookHash: 'h2' }));
+    expect(e.occurrences.map((o) => o.sentence)).toEqual(['B cat.', 'B cat.', 'A cat.']);
+    // The same sentence in the same book is one occurrence, even at a new CFI
+    // (hint markup changes the CFI of a word looked up again).
+    const again = addOccurrence(e, occ('A cat.', 4, { cfi: 'epubcfi(/6/2!/4/77)' }));
+    expect(again.occurrences.map((o) => [o.sentence, o.at])).toEqual([
+      ['A cat.', 4],
+      ['B cat.', 3],
+      ['B cat.', 2],
+    ]);
+  });
+  it(`keeps at most ${MAX_OCCURRENCES}`, () => {
+    let e = entry();
+    for (let i = 0; i < MAX_OCCURRENCES + 5; i++) e = addOccurrence(e, occ(`S${i}.`, i));
+    expect(e.occurrences).toHaveLength(MAX_OCCURRENCES);
+    expect(e.occurrences[0]!.sentence).toBe(`S${MAX_OCCURRENCES + 4}.`);
+  });
+});
+
+describe('mergeEntries', () => {
+  it('keeps the same display word whatever the argument order', () => {
+    const a = entry({ word: 'Serendipity', modifiedAt: 0 });
+    const b = entry({ word: 'serendipity', modifiedAt: 0 });
+    expect(mergeEntries(a, b).word).toBe(mergeEntries(b, a).word);
+  });
+
+  it('takes state and hint from the newer side and unions occurrences', () => {
+    const a = entry({
+      state: 'learning',
+      hint: '意外',
+      modifiedAt: 10,
+      occurrences: [occ('A.', 5)],
+    });
+    const b = entry({ state: 'none', modifiedAt: 8, occurrences: [occ('B.', 7)] });
+    const m = mergeEntries(a, b);
+    expect(m.state).toBe('learning');
+    expect(m.hint).toBe('意外');
+    expect(m.modifiedAt).toBe(10);
+    expect(m.occurrences.map((o) => o.sentence)).toEqual(['B.', 'A.']);
+    expect(mergeEntries(b, a)).toEqual(m);
+  });
+  it('keeps a delete that is newer than every occurrence', () => {
+    const deleted = entry({ deletedAt: 20, modifiedAt: 20, occurrences: [] });
+    const old = entry({ state: 'learning', modifiedAt: 10, occurrences: [occ('A.', 5)] });
+    const m = mergeEntries(deleted, old);
+    expect(m.deletedAt).toBe(20);
+    expect(m.occurrences).toEqual([]);
+  });
+  it('revives a deleted word looked up again after the delete', () => {
+    const deleted = entry({ deletedAt: 20, modifiedAt: 20, occurrences: [] });
+    // A device that missed the delete still holds the old sentence.
+    const relooked = entry({
+      state: 'learning',
+      modifiedAt: 30,
+      occurrences: [occ('New.', 30), occ('Old.', 5)],
+    });
+    const m = mergeEntries(deleted, relooked);
+    expect(m.deletedAt).toBeNull();
+    expect(m.occurrences.map((o) => o.sentence)).toEqual(['New.']);
+    expect(mergeEntries(relooked, deleted)).toEqual(m);
+  });
+  it('revives a word looked up after the delete on a device that missed it', () => {
+    // Lookups don't move modifiedAt, so the stale copy is older than the delete.
+    const deleted = entry({ deletedAt: 20, modifiedAt: 20, occurrences: [] });
+    const stale = entry({
+      state: 'learning',
+      hint: '旧',
+      modifiedAt: 15,
+      occurrences: [occ('New.', 30), occ('Old.', 5)],
+    });
+    const m = mergeEntries(deleted, stale);
+    expect(m.deletedAt).toBeNull();
+    expect(m.state).toBe('none');
+    expect(m.hint).toBeUndefined();
+    expect(m.occurrences.map((o) => o.sentence)).toEqual(['New.']);
+    expect(mergeEntries(stale, deleted)).toEqual(m);
+  });
+});
+
+describe('vocabularyLang', () => {
+  it('uses the base code and falls back to und', () => {
+    expect(vocabularyLang('en-US')).toBe('en');
+    expect(vocabularyLang('ZH')).toBe('zh');
+    expect(vocabularyLang(undefined)).toBe('und');
+    expect(vocabularyLang('')).toBe('und');
+  });
+});
+
+describe('mergeEntries tie-break', () => {
+  it('picks the same winner whatever the order when modifiedAt ties', () => {
+    const a = entry({ state: 'learning', modifiedAt: 10 });
+    const b = entry({ state: 'mastered', modifiedAt: 10 });
+    expect(mergeEntries(a, b).state).toBe(mergeEntries(b, a).state);
+    const h1 = entry({ state: 'learning', hint: 'x', modifiedAt: 10 });
+    const h2 = entry({ state: 'learning', hint: 'y', modifiedAt: 10 });
+    expect(mergeEntries(h1, h2).hint).toBe(mergeEntries(h2, h1).hint);
+  });
+});
