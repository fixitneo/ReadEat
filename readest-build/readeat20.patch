+    open: vi.fn(async (path: string) => {
+      calls.push(`open ${path}`);
+      return {};
+    }),
+  },
+}));
+
+vi.mock('@/services/database/migrate', () => ({
+  migrate: vi.fn().mockResolvedValue(undefined),
+}));
