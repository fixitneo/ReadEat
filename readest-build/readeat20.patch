+    expect(res.status).toBe(400);
+    expect(embedManyMock).not.toHaveBeenCalled();
+  });
+
+  it('embed uses the caller key', async () => {
+    const res = await embedPOST(post('embed', { texts: ['a', 'b'], apiKey: 'user-key' }));
