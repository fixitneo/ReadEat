+    const heatmap = screen.getByRole('group', { name: 'Reading activity' });
+    fireEvent.focus(heatmap);
+    fireEvent.keyDown(heatmap, { key: 'ArrowDown' });
+    expect(heatmapStatus!.textContent).toContain('22');
+  });
+});
