@@ -0,0 +1,40 @@
+import type {
+  SqliteTTSCacheStore,
+  TTSPackSidecar,
+} from '@/services/tts/providers/sqliteCacheStore';
+import { SYNC_BOOK_TTS_DIR } from '@/services/sync/file/layout';
+import type { BookDataKind } from './engine';
+
+// Downloaded TTS sections: each pack is `<section>-<keysfp>.mp3` plus a
+// `.json` sidecar of its entry offsets, uploaded after the mp3. Only
+// downloaded sections are listed (SqliteTTSCacheStore.listPacks).
+const sidecarNameOf = (packName: string) => packName.replace(/\.mp3$/, '.json');
+
+export const createTTSBookDataKind = (store: SqliteTTSCacheStore): BookDataKind => ({
+  id: SYNC_BOOK_TTS_DIR,
+  listLocal: async () => (await store.listPacks()).map((pack) => pack.name),
+  filesOf: (unit) => [unit, sidecarNameOf(unit)],
+  contentTypeOf: (file) => (file.endsWith('.json') ? 'application/json' : 'audio/mpeg'),
+  async readLocal(unit, file) {
+    if (file === unit) return store.readPackBytes(unit);
+    const sidecar = await store.buildPackSidecar(unit);
+    return sidecar
+      ? (new TextEncoder().encode(JSON.stringify(sidecar)).buffer as ArrayBuffer)
+      : null;
+  },
+  unitOf: (file) => (file.endsWith('.json') ? file.replace(/\.json$/, '.mp3') : null),
+  hasLocal: (unit) => store.hasPack(unit),
+  async importUnit(unit, read) {
+    const text = await read(sidecarNameOf(unit));
+    if (!text) return false;
+    let sidecar: TTSPackSidecar;
+    try {
+      sidecar = JSON.parse(new TextDecoder().decode(text)) as TTSPackSidecar;
+    } catch {
+      return false;
+    }
+    const bytes = await read(unit);
+    if (!bytes) return false;
+    return store.importPack(bytes, sidecar);
+  },
+});
diff --git a/apps/readest-app/src/services/sync/bookData/types.ts b/apps/readest-app/src/services/sync/bookData/types.ts
new file mode 100644
--- /dev/null
+++ b/apps/readest-app/src/services/sync/bookData/types.ts
@@ -0,0 +1,24 @@
+// A place a book's data files sync to: one per enabled file-sync backend,
+// plus Readest Cloud for books uploaded there. Every destination holds the
+// same layout, `<book dir>/<kind>/<name>`, and files are content-named and
+// immutable, so a listed name already has the right bytes.
+export interface BookDataDestination {
+  /** 'readest' or the file-sync backend kind, for logs. */
+  readonly id: string;
+  /**
+   * File names in the book's kind folder; empty for a missing folder, throws on
+   * other errors. Null when this destination does not hold the book itself, so
+   * the book's data does not go there either.
+   */
+  list(bookHash: string, kind: string): Promise<Set<string> | null>;
+  /** A file's bytes, or null when it is missing or unreadable. */
+  read(bookHash: string, kind: string, name: string): Promise<ArrayBuffer | null>;
+  /** Upload one file. Throws on failure (quota, network, auth). */
+  write(
+    bookHash: string,
+    kind: string,
+    name: string,
+    body: ArrayBuffer,
+    contentType: string,
+  ): Promise<void>;
+}
