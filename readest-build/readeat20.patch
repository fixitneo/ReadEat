+    await waitFor(() => expect(onImport).toHaveBeenCalledTimes(1));
+    await screen.findByRole('alert');
+    expect(onClose).not.toHaveBeenCalled();
+    expect(screen.getByLabelText('Text')).toHaveProperty('value', 'Keep this text');
+  });
+});
