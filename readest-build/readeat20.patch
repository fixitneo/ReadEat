+  });
+
+  test('skips Readest Cloud for a book that is not uploaded', async () => {
+    gateMock.mockReturnValue({ readest: true, backends: [], paused: false });
+    setSettings({ readestCloud: { enabled: true } } as Partial<SystemSettings>);
